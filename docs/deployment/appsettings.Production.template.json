{
  "_comment": "Production TEMPLATE. Do not commit real secrets. Supply values via environment variables / secret store.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=<SQL_HOST>;Database=INCIS_SaaP;User Id=<USER>;Password=<PASSWORD>;TrustServerCertificate=True;Max Pool Size=100;"
  },
  "Security": {
    "EnforceHttps": true,
    "AllowSelfRegistration": false
  },
  "Api": {
    "WritePolicy": { "Enforce": false, "Roles": "Admin,SuperUser,TenantAdmin" },
    "Csrf": { "Enforce": false, "HeaderName": "X-CSRF-TOKEN" },
    "DemoToken": { "Enabled": false }
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_LONG_RANDOM_SECRET_32_PLUS"
  },
  "AdminSeed": {
    "Email": "admin@<DOMAIN>",
    "Password": ""
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseSsl": true,
    "From": "noreply@<DOMAIN>"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    },
    "WriteTo": [
      { "Name": "File", "Args": { "path": "logs/incis-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ]
  },
  "AllowedHosts": "*"
}
