@model PaginatedList<INCIS_SaaP.Models.INCI>
@{
    ViewData["Title"] = "Προηγμένη Αναζήτηση INCI";
    var search = ViewData["CurrentFilter"] as string;
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Index">Συστατικά INCI</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Προηγμένη Αναζήτηση</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-magnifying-glass-plus"></i></div>
    <div class="erp-page-header-text">
        <h1>Προηγμένη Αναζήτηση Ουσιών INCI</h1>
        <div class="erp-page-header-subtitle">Αναζητήστε με όνομα, CAS ή EC Number — δείτε αμέσως σε ποιες α’ ύλες εμφανίζεται</div>
    </div>
    <div class="erp-page-header-actions">
        <a asp-action="Index" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-2"></i>Επιστροφή</a>
    </div>
</div>

<div class="erp-card mb-3 erp-fade-in">
    <div class="erp-card-header"><h3><i class="fas fa-filter text-erp-primary"></i> Φίλτρο</h3></div>
    <div class="erp-card-body">
        <form asp-action="AdvanceSearch" method="get" class="d-flex flex-wrap gap-2 align-items-end">
            <div class="flex-grow-1" style="min-width: 240px;">
                <label class="form-label fw-semibold">Όνομα / CAS / EC</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-magnifying-glass"></i></span>
                    <input type="search" name="searchString" value="@search" class="form-control" placeholder="π.χ. Glycerin, 56-81-5..." />
                </div>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-magnifying-glass me-1"></i>Αναζήτηση</button>
            @if (!string.IsNullOrEmpty(search))
            {
                <a asp-action="AdvanceSearch" class="btn btn-erp-secondary"><i class="fas fa-xmark me-1"></i>Καθαρισμός</a>
            }
        </form>
    </div>
</div>

<div class="erp-card erp-fade-in">
    <div class="erp-card-header">
        <h3><i class="fas fa-list-ul text-erp-primary"></i> Αποτελέσματα</h3>
        <span class="erp-badge erp-badge-primary ms-2">@Model.TotalItems</span>
    </div>
    <div class="table-responsive">
        @if (Model.Any())
        {
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Όνομα</th>
                        <th class="d-none d-md-table-cell">CAS</th>
                        <th class="d-none d-lg-table-cell">EC</th>
                        <th class="d-none d-md-table-cell">Α’ Ύλες</th>
                        <th>Κατάσταση</th>
                        <th class="text-end">Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td class="d-none d-md-table-cell"><code>@(item.CASNumber ?? "—")</code></td>
                            <td class="d-none d-lg-table-cell"><code>@(item.ECNumber ?? "—")</code></td>
                            <td class="d-none d-md-table-cell">
                                @if (item.RawMaterials != null && item.RawMaterials.Any())
                                {
                                    <span class="erp-badge erp-badge-info">@item.RawMaterials.Count() ύλες</span>
                                    <div class="mt-1 small text-muted">
                                        @string.Join(", ", item.RawMaterials.Take(3).Select(x => x.ProductName))
                                        @if (item.RawMaterials.Count > 3) { <span> +@(item.RawMaterials.Count - 3)</span> }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive) { <span class="erp-badge erp-badge-success"><i class="fas fa-check"></i>Ενεργό</span> }
                                else { <span class="erp-badge erp-badge-secondary">Ανενεργό</span> }
                            </td>
                            <td class="text-end">
                                <div class="erp-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary"><i class="fas fa-pen"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger"><i class="fas fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="erp-empty">
                <div class="erp-empty-icon"><i class="fas fa-magnifying-glass"></i></div>
                <h5 class="text-body">Καμία αντιστοιχία</h5>
                <p>@(string.IsNullOrEmpty(search) ? "Πληκτρολογήστε όρο αναζήτησης παραπάνω." : $"Δεν βρέθηκε αποτέλεσμα για \"{search}\".")</p>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="erp-card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <small class="text-muted">Σελίδα @Model.PageIndex από @Model.TotalPages</small>
            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="AdvanceSearch" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-searchString="@search"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (var i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="AdvanceSearch" asp-route-pageNumber="@i" asp-route-searchString="@search">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="AdvanceSearch" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-searchString="@search"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
