@*
    CosIng Search & Regulatory Check Partial View
    ==============================================
    Χρησιμοποιείται σε ΟΛΕΣ τις φόρμες δημιουργίας/επεξεργασίας φόρμουλας.
    Παρέχει:
    1. Autocomplete αναζήτηση INCI Ingredients (24.094 εγγραφές)
    2. Real-time regulatory check (Annex II-VI)
    3. Εμφάνιση περιορισμών, μέγιστων συγκεντρώσεων, προειδοποιήσεων

    Χρήση σε View:
    <partial name="_CosIngSearch" />
*@

<div class="erp-card mb-3" id="cosing-search-panel">
    <div class="erp-card-header">
        <h3><i class="fas fa-database text-erp-primary"></i> CosIng - Αναζήτηση Συστατικών (EU 1223/2009)</h3>
    </div>
    <div class="erp-card-body">
        <!-- Search Input -->
        <div class="row g-2 mb-3">
            <div class="col-md-8">
                <label class="form-label fw-semibold">
                    <i class="fas fa-search"></i> Αναζήτηση INCI / CAS / EC Number
                </label>
                <input type="text" 
                       id="cosing-search-input"
                       class="form-control cosing-autocomplete" 
                       placeholder="Πληκτρολογήστε INCI name, CAS number ή EC number..."
                       data-cas-target="#cosing-result-cas"
                       data-ec-target="#cosing-result-ec"
                       data-function-target="#cosing-result-function"
                       autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold"><i class="fas fa-shield-alt"></i> Regulatory Check</label>
                <button type="button" class="btn btn-outline-primary w-100" id="cosing-check-btn" onclick="CosIng_RunCheck()">
                    <i class="fas fa-gavel me-1"></i> Έλεγχος Ουσίας
                </button>
            </div>
        </div>

        <!-- Results Panel -->
        <div id="cosing-result-panel" style="display:none;">
            <div class="row g-2">
                <div class="col-md-4">
                    <small class="text-muted d-block">CAS Number</small>
                    <input type="text" id="cosing-result-cas" class="form-control form-control-sm" readonly />
                </div>
                <div class="col-md-4">
                    <small class="text-muted d-block">EC Number</small>
                    <input type="text" id="cosing-result-ec" class="form-control form-control-sm" readonly />
                </div>
                <div class="col-md-4">
                    <small class="text-muted d-block">Function</small>
                    <input type="text" id="cosing-result-function" class="form-control form-control-sm" readonly />
                </div>
            </div>
        </div>

        <!-- Regulatory Alert -->
        <div id="cosing-alerts" class="mt-3" style="display:none;"></div>

        <!-- Regulatory Details -->
        <div id="cosing-regulatory-details" class="mt-3" style="display:none;">
            <div class="accordion" id="cosing-accordion">
                <div class="accordion-item" id="cosing-detail-restricted" style="display:none;">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-warning bg-opacity-10" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-restricted">
                            <i class="fas fa-exclamation-triangle text-warning me-2"></i> Περιορισμοί Χρήσης (Annex III)
                        </button>
                    </h2>
                    <div id="collapse-restricted" class="accordion-collapse collapse">
                        <div class="accordion-body small" id="cosing-restricted-content"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Εμφάνιση result panel μόλις επιλεγεί ingredient
    document.addEventListener('cosing:selected', function(e) {
        document.getElementById('cosing-result-panel').style.display = 'block';
        const result = e.detail.regulatoryCheck;
        if (result && result.isRestricted && result.details) {
            showRegulatoryDetails(result.details);
        }
    });

    function CosIng_RunCheck() {
        const name = document.getElementById('cosing-search-input').value;
        if (!name || name.length < 2) return;

        CosIng.checkIngredient(name).then(result => {
            const alertsDiv = document.getElementById('cosing-alerts');
            alertsDiv.style.display = 'block';

            if (result.isProhibited) {
                alertsDiv.innerHTML = '<div class="alert alert-danger"><i class="fas fa-ban me-2"></i><strong>ΑΠΑΓΟΡΕΥΜΕΝΗ ΟΥΣΙΑ</strong> (Annex II, Regulation EC 1223/2009)<br>Αυτή η ουσία ΔΕΝ επιτρέπεται σε καλλυντικά προϊόντα!</div>';
            } else if (result.isRestricted) {
                let html = '<div class="alert alert-warning"><i class="fas fa-exclamation-triangle me-2"></i><strong>ΟΥΣΙΑ ΜΕ ΠΕΡΙΟΡΙΣΜΟΥΣ</strong> (Annex III)';
                if (result.maxConcentration) html += '<br><strong>Μέγιστη συγκέντρωση:</strong> ' + result.maxConcentration;
                if (result.warnings) html += '<br><strong>Προειδοποιήσεις:</strong> ' + result.warnings;
                html += '</div>';
                alertsDiv.innerHTML = html;
                if (result.details) showRegulatoryDetails(result.details);
            } else {
                alertsDiv.innerHTML = '<div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>Η ουσία δεν έχει κανονιστικούς περιορισμούς στα Παραρτήματα II-VI.</div>';
            }

            if (result.hasCMR) {
                alertsDiv.innerHTML += '<div class="alert alert-danger mt-2"><i class="fas fa-radiation me-2"></i><strong>CMR Ουσία</strong> - Καρκινογόνα / Μεταλλαξιογόνα / Τοξικά για την Αναπαραγωγή</div>';
            }
        });
    }

    function showRegulatoryDetails(details) {
        const panel = document.getElementById('cosing-regulatory-details');
        if (details.restricted && details.restricted.length > 0) {
            panel.style.display = 'block';
            const item = document.getElementById('cosing-detail-restricted');
            item.style.display = 'block';
            let html = '<table class="table table-sm"><tbody>';
            details.restricted.forEach(r => {
                if (r.productType) html += '<tr><th>Τύπος Προϊόντος</th><td>' + r.productType + '</td></tr>';
                if (r.maxConcentration) html += '<tr><th>Μέγιστη Συγκέντρωση</th><td>' + r.maxConcentration + '</td></tr>';
                if (r.warnings) html += '<tr><th>Προειδοποιήσεις</th><td>' + r.warnings + '</td></tr>';
                if (r.otherRestrictions) html += '<tr><th>Λοιποί Περιορισμοί</th><td>' + r.otherRestrictions + '</td></tr>';
                if (r.cmr) html += '<tr><th>CMR</th><td class="text-danger fw-bold">' + r.cmr + '</td></tr>';
            });
            html += '</tbody></table>';
            document.getElementById('cosing-restricted-content').innerHTML = html;
        }
    }
</script>
