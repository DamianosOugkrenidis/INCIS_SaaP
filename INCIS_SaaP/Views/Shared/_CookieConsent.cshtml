@*
    Cookie consent banner (GDPR). Εμφανίζεται μέχρι ο χρήστης να αποδεχτεί.
    Χρησιμοποιούμε μόνο απαραίτητα cookies (auth/session).
*@
<div id="cookie-consent" style="display:none; position:fixed; left:16px; right:16px; bottom:16px; z-index:2000;
     background:#1a237e; color:#fff; border-radius:12px; padding:14px 18px; box-shadow:0 8px 28px rgba(0,0,0,.25);">
    <div class="d-flex flex-wrap align-items-center gap-2 justify-content-between">
        <div class="small flex-grow-1" style="min-width:240px;">
            <i class="fas fa-cookie-bite me-2"></i>
            Χρησιμοποιούμε απαραίτητα cookies για την αυθεντικοποίηση και τη λειτουργία της πλατφόρμας.
            <a asp-controller="Legal" asp-action="Privacy" class="text-white text-decoration-underline">Μάθετε περισσότερα</a>.
        </div>
        <button type="button" id="cookie-consent-accept" class="btn btn-light btn-sm">Αποδοχή</button>
    </div>
</div>
<script>
    (function () {
        try {
            var KEY = 'incis_cookie_consent';
            if (!localStorage.getItem(KEY)) {
                var el = document.getElementById('cookie-consent');
                if (el) el.style.display = 'block';
            }
            var btn = document.getElementById('cookie-consent-accept');
            if (btn) btn.addEventListener('click', function () {
                localStorage.setItem(KEY, '1');
                var el = document.getElementById('cookie-consent');
                if (el) el.style.display = 'none';
            });
        } catch (e) { /* localStorage unavailable */ }
    })();
</script>
