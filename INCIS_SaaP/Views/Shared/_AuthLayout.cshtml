@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#714B67" />
    <title>@(ViewData["Title"] ?? "Login") · INCIS SaaP</title>

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%A7%AA%3C/text%3E%3C/svg%3E" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/odoo-erp.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <header class="auth-banner">
        <div class="auth-logo"><i class="fas fa-flask"></i></div>
        <h1>INCIS <strong>SaaP</strong></h1>
        <div class="auth-subtitle">Intelligent Cosmetics Compliance &amp; Science Platform</div>
    </header>

    <main role="main" class="auth-main">
        @RenderBody()
    </main>

    <footer class="auth-footer">
        <i class="fas fa-shield-halved me-1"></i>
        <span>© @DateTime.Now.Year INCIS SaaP — Secure Science Platform</span>
        <span class="mx-2">·</span>
        <a asp-controller="Legal" asp-action="Terms" class="text-decoration-none">Όροι Χρήσης</a>
        <span class="mx-1">·</span>
        <a asp-controller="Legal" asp-action="Privacy" class="text-decoration-none">Απόρρητο</a>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_CookieConsent" />
</body>
</html>
