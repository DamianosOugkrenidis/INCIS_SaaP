@model INCIS_SaaP.Controllers.ErrorViewModel
@{
    ViewData["Title"] = "Σφάλμα";
    Layout = User?.Identity?.IsAuthenticated == true ? "_ERPLayout" : "_AuthLayout";
}

@if (User?.Identity?.IsAuthenticated == true)
{
    <div class="erp-card erp-fade-in mx-auto" style="max-width: 720px; margin-top: 2rem;">
        <div class="erp-card-body text-center py-5">
            <div class="erp-empty-icon mb-3" style="background: var(--erp-danger-soft); color: var(--erp-danger);">
                <i class="fas fa-circle-exclamation"></i>
            </div>
            <h2 class="mb-2 fw-bold">Παρουσιάστηκε σφάλμα</h2>
            <p class="text-muted mb-2">Συνέβη ένα μη αναμενόμενο σφάλμα κατά την εκτέλεση του αιτήματός σας.</p>
            @if (Model?.ShowRequestId == true)
            {
                <p class="small text-muted mb-3">Request ID: <code>@Model.RequestId</code></p>
            }
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="fas fa-house me-2"></i>Επιστροφή στην Αρχική</a>
                <button class="btn btn-erp-secondary" onclick="window.history.back()"><i class="fas fa-arrow-left me-2"></i>Πίσω</button>
            </div>
        </div>
    </div>
}
else
{
    <div class="auth-card text-center" style="max-width: 460px;">
        <div class="erp-empty-icon mx-auto mb-3" style="background: var(--erp-danger-soft); color: var(--erp-danger);">
            <i class="fas fa-circle-exclamation"></i>
        </div>
        <h2 class="auth-card-title">Σφάλμα</h2>
        <p class="auth-card-subtitle">Παρουσιάστηκε σφάλμα. Παρακαλώ δοκιμάστε ξανά.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="small text-muted mb-3">Request ID: <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100"><i class="fas fa-right-to-bracket me-2"></i>Σύνδεση</a>
    </div>
}
