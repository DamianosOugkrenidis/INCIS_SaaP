@model IEnumerable<INCIS_SaaP.Models.Formula>
@{
    ViewData["Title"] = "Dashboard";
    var labels = (List<string>)(ViewBag.MonthlyLabels ?? new List<string>());
    var values = (List<int>)(ViewBag.MonthlyValues ?? new List<int>());
    int totalFormulas = ViewBag.TotalFormulas ?? 0;
    int totalINCI = ViewBag.TotalINCI ?? 0;
    int totalRaw = ViewBag.TotalRawMaterials ?? 0;
    int totalAllergens = ViewBag.TotalAllergens ?? 0;
    int totalClients = ViewBag.TotalClients ?? 0;
    int totalSuppliers = ViewBag.TotalSuppliers ?? 0;
    int activeFormulas = ViewBag.ActiveFormulas ?? 0;
    int wipFormulas = ViewBag.WipFormulas ?? 0;
    int activeRaw = ViewBag.ActiveRawMaterials ?? 0;
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Dashboard</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-gauge-high"></i></div>
    <div class="erp-page-header-text">
        <h1>Επισκόπηση Συστήματος</h1>
        <div class="erp-page-header-subtitle">
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <text>Καλώς ήρθατε, <strong>@User.Identity.Name</strong>! Συνοπτική εικόνα του φόρτου εργασίας.</text>
            }
            else
            {
                <text>Δημόσια επισκόπηση. Συνδεθείτε για πλήρη πρόσβαση.</text>
            }
        </div>
    </div>
    <div class="erp-page-header-actions">
        <button class="btn btn-erp-secondary" onclick="window.location.reload()" title="Ανανέωση">
            <i class="fas fa-arrow-rotate-right"></i><span class="d-none d-md-inline ms-2">Ανανέωση</span>
        </button>
        @if (User?.IsInRole("Admin") == true || User?.IsInRole("SuperUser") == true)
        {
            <a asp-controller="Formulas" asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Νέα Φόρμουλα
            </a>
        }
    </div>
</div>

<!-- ============== STAT WIDGETS ============== -->
<div class="row g-3 mb-4 erp-fade-in">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="erp-stat --primary">
            <div class="erp-stat-icon"><i class="fas fa-flask"></i></div>
            <div class="erp-stat-value">@totalFormulas</div>
            <div class="erp-stat-label">Φόρμουλες</div>
            @if (activeFormulas > 0)
            {
                <span class="erp-stat-trend up"><i class="fas fa-circle-check"></i>@activeFormulas validated</span>
            }
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="erp-stat --info">
            <div class="erp-stat-icon"><i class="fas fa-atom"></i></div>
            <div class="erp-stat-value">@totalINCI</div>
            <div class="erp-stat-label">Συστατικά INCI</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="erp-stat --success">
            <div class="erp-stat-icon"><i class="fas fa-cubes"></i></div>
            <div class="erp-stat-value">@totalRaw</div>
            <div class="erp-stat-label">Πρώτες Ύλες</div>
            @if (activeRaw > 0)
            {
                <span class="erp-stat-trend up"><i class="fas fa-check"></i>@activeRaw ενεργές</span>
            }
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="erp-stat --warning">
            <div class="erp-stat-icon"><i class="fas fa-triangle-exclamation"></i></div>
            <div class="erp-stat-value">@totalAllergens</div>
            <div class="erp-stat-label">Αλλεργιογόνα</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="erp-stat --accent">
            <div class="erp-stat-icon"><i class="fas fa-handshake"></i></div>
            <div class="erp-stat-value">@totalClients</div>
            <div class="erp-stat-label">Πελάτες</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="erp-stat --danger">
            <div class="erp-stat-icon"><i class="fas fa-truck-fast"></i></div>
            <div class="erp-stat-value">@totalSuppliers</div>
            <div class="erp-stat-label">Προμηθευτές</div>
        </div>
    </div>
</div>

<!-- ============== CHARTS + ACTIVITY ============== -->
<div class="row g-3 mb-4 erp-fade-in">
    <div class="col-12 col-xl-8">
        <div class="erp-card h-100">
            <div class="erp-card-header">
                <h3><i class="fas fa-chart-line text-erp-primary"></i> Νέες Φόρμουλες ανά μήνα</h3>
                <div class="erp-card-actions">
                    <span class="erp-badge erp-badge-primary"><i class="fas fa-calendar"></i>Τελευταίοι 6 μήνες</span>
                </div>
            </div>
            <div class="erp-card-body">
                <div style="position:relative;height:280px;"><canvas id="formulasChart"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="erp-card h-100">
            <div class="erp-card-header">
                <h3><i class="fas fa-heart-pulse text-erp-primary"></i> Κατάσταση φόρμουλας</h3>
            </div>
            <div class="erp-card-body">
                <div style="position:relative;height:200px;"><canvas id="statusChart"></canvas></div>
                <div class="mt-3">
                    <div class="d-flex justify-content-between align-items-center small mb-2">
                        <span><span class="d-inline-block rounded-circle me-2" style="width:10px;height:10px;background:#10b981;"></span>Validated</span>
                        <strong>@activeFormulas</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center small mb-2">
                        <span><span class="d-inline-block rounded-circle me-2" style="width:10px;height:10px;background:#f59e0b;"></span>WIP</span>
                        <strong>@wipFormulas</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center small">
                        <span><span class="d-inline-block rounded-circle me-2" style="width:10px;height:10px;background:#9ca3af;"></span>Άλλες</span>
                        <strong>@(Math.Max(0, totalFormulas - activeFormulas - wipFormulas))</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============== QUICK ACTIONS ============== -->
<div class="erp-card mb-4 erp-fade-in">
    <div class="erp-card-header">
        <h3><i class="fas fa-bolt text-erp-primary"></i> Γρήγορες Ενέργειες</h3>
    </div>
    <div class="erp-card-body">
        <div class="row g-3">
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <a asp-controller="Formulas" asp-action="Create" class="erp-quick-card">
                    <div class="erp-stat-icon" style="background: var(--erp-gradient-soft); color: var(--erp-primary);"><i class="fas fa-plus"></i></div>
                    <div class="fw-semibold text-body">Νέα Φόρμουλα</div>
                    <small class="text-muted">Δημιουργία</small>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <a asp-controller="RawMaterials" asp-action="Create" class="erp-quick-card">
                    <div class="erp-stat-icon" style="background: rgba(16,185,129,.12); color: var(--erp-success);"><i class="fas fa-cubes"></i></div>
                    <div class="fw-semibold text-body">Νέα Α' Ύλη</div>
                    <small class="text-muted">Καταχώρηση</small>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <a asp-controller="INCIs" asp-action="Create" class="erp-quick-card">
                    <div class="erp-stat-icon" style="background: rgba(59,130,246,.12); color: var(--erp-info);"><i class="fas fa-atom"></i></div>
                    <div class="fw-semibold text-body">INCI</div>
                    <small class="text-muted">Συστατικό</small>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <a asp-controller="Clients" asp-action="Create" class="erp-quick-card">
                    <div class="erp-stat-icon" style="background: rgba(155,89,182,.12); color: var(--erp-accent);"><i class="fas fa-handshake"></i></div>
                    <div class="fw-semibold text-body">Πελάτης</div>
                    <small class="text-muted">Νέα εγγραφή</small>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <a asp-controller="Suppliers" asp-action="Create" class="erp-quick-card">
                    <div class="erp-stat-icon" style="background: rgba(245,158,11,.12); color: var(--erp-warning);"><i class="fas fa-truck"></i></div>
                    <div class="fw-semibold text-body">Προμηθευτής</div>
                    <small class="text-muted">Νέα εγγραφή</small>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <a asp-controller="Reports" asp-action="Index" class="erp-quick-card">
                    <div class="erp-stat-icon" style="background: rgba(239,68,68,.12); color: var(--erp-danger);"><i class="fas fa-chart-bar"></i></div>
                    <div class="fw-semibold text-body">Αναφορές</div>
                    <small class="text-muted">Export Excel</small>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ============== RECENT FORMULAS ============== -->
<div class="erp-card erp-fade-in">
    <div class="erp-card-header">
        <h3><i class="fas fa-clock-rotate-left text-erp-primary"></i> Πρόσφατες Φόρμουλες</h3>
        <div class="erp-card-actions">
            <a asp-controller="Formulas" asp-action="Index" class="btn btn-sm btn-erp-secondary">
                Όλες <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="table-responsive">
        @if (Model != null && Model.Any())
        {
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Κωδικός</th>
                        <th>Όνομα Προϊόντος</th>
                        <th class="d-none d-md-table-cell">Τύπος</th>
                        <th class="d-none d-lg-table-cell">Έκδοση</th>
                        <th class="d-none d-md-table-cell">Τροποποίηση</th>
                        <th>Κατάσταση</th>
                        <th class="text-end">Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td><span class="erp-badge erp-badge-primary">@f.FormulaCode</span></td>
                            <td class="fw-semibold">@(f.FormulaName ?? f.ProductName ?? "—")</td>
                            <td class="d-none d-md-table-cell">@(f.ProductType ?? "—")</td>
                            <td class="d-none d-lg-table-cell"><code>@(string.IsNullOrEmpty(f.Version) ? "v1.0" : f.Version)</code></td>
                            <td class="d-none d-md-table-cell"><small class="text-muted">@(f.LastModified?.ToString("dd/MM/yyyy") ?? "—")</small></td>
                            <td>
                                @if (f.IsValidated)
                                {
                                    <span class="erp-badge erp-badge-success"><i class="fas fa-check"></i>Validated</span>
                                }
                                else if (f.IsWIP)
                                {
                                    <span class="erp-badge erp-badge-warning"><i class="fas fa-clock"></i>WIP</span>
                                }
                                else
                                {
                                    <span class="erp-badge erp-badge-secondary"><i class="fas fa-pen"></i>Draft</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Formulas" asp-action="Details" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary" title="Λεπτομέρειες">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="erp-empty">
                <div class="erp-empty-icon"><i class="fas fa-flask-vial"></i></div>
                <h5 class="text-body">Καμία φόρμουλα ακόμα</h5>
                <p class="mb-3">Ξεκινήστε δημιουργώντας την πρώτη φόρμουλα.</p>
                <a asp-controller="Formulas" asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Νέα Φόρμουλα</a>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .erp-quick-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 16px 12px;
            border-radius: var(--erp-radius-lg);
            border: 1px solid var(--erp-border);
            background: var(--erp-surface);
            text-decoration: none;
            color: inherit;
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
            height: 100%;
        }
        .erp-quick-card .erp-stat-icon { margin-bottom: 8px; }
        .erp-quick-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--erp-shadow);
            border-color: rgba(113,75,103,.3);
            color: inherit;
        }
    </style>
}

@section Scripts {
    <script>
        (function () {
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels));
            const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(values));

            const ctx = document.getElementById('formulasChart');
            if (ctx && window.Chart) {
                const gradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 280);
                gradient.addColorStop(0, 'rgba(113,75,103,.45)');
                gradient.addColorStop(1, 'rgba(113,75,103,0)');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Φόρμουλες',
                            data: values,
                            borderColor: '#714B67',
                            backgroundColor: gradient,
                            borderWidth: 3,
                            tension: 0.35,
                            fill: true,
                            pointBackgroundColor: '#9B59B6',
                            pointRadius: 5,
                            pointHoverRadius: 7
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: 'rgba(0,0,0,.05)' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            const sCtx = document.getElementById('statusChart');
            if (sCtx && window.Chart) {
                const validated = @activeFormulas;
                const wip = @wipFormulas;
                const others = Math.max(0, @totalFormulas - validated - wip);
                new Chart(sCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Validated','WIP','Άλλες'],
                        datasets: [{
                            data: [validated, wip, others],
                            backgroundColor: ['#10b981', '#f59e0b', '#9ca3af'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: { legend: { display: false } }
                    }
                });
            }
        })();
    </script>
}
