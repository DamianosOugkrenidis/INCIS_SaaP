@model List<INCIS_SaaP.Models.INCIIngredient>
@{
    var formulaId = (int)ViewData["FormulaId"]!;
    var formulaCode = ViewData["FormulaCode"] as string;
    ViewData["Title"] = "Συστατικά INCI · " + formulaCode;
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Index">Διαχείριση Προϊόντος</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Manage" asp-route-id="@formulaId">@formulaCode</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Συστατικά INCI</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-atom"></i></div>
    <div class="erp-page-header-text">
        <h1>Συστατικά INCI <span class="erp-badge erp-badge-info ms-2">FORM5</span></h1>
        <div class="erp-page-header-subtitle">Φόρμουλα @formulaCode · @Model.Count εγγραφές</div>
    </div>
    <div class="erp-page-header-actions">
        <form asp-action="GenerateInci" asp-route-formulaId="@formulaId" method="post" class="d-inline" onsubmit="return confirm('Θα υπολογιστεί η λίστα INCI από τη σύνθεση α'' υλών και θα αντικαταστήσει τα τρέχοντα συστατικά. Συνέχεια;');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-erp-secondary"><i class="fas fa-wand-magic-sparkles me-2"></i>Υπολογισμός από Σύνθεση</button>
        </form>
        <a asp-action="InciCreate" asp-route-formulaId="@formulaId" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Νέο Συστατικό</a>
    </div>
</div>

<div class="erp-card erp-fade-in">
    <div class="table-responsive">
        @if (Model.Any())
        {
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>INCI Name</th>
                        <th class="d-none d-md-table-cell">Λειτουργία</th>
                        <th>%</th>
                        <th class="d-none d-lg-table-cell">CAS</th>
                        <th class="d-none d-lg-table-cell">EC</th>
                        <th class="text-end">Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@(item.INCIName ?? "—")</td>
                            <td class="d-none d-md-table-cell">@(item.Function ?? "—")</td>
                            <td>@(item.Percentage?.ToString("0.####") ?? "—")</td>
                            <td class="d-none d-lg-table-cell"><small class="text-muted">@(item.CASNumber ?? "—")</small></td>
                            <td class="d-none d-lg-table-cell"><small class="text-muted">@(item.ECNumber ?? "—")</small></td>
                            <td class="text-end">
                                <div class="erp-actions">
                                    <a asp-action="InciEdit" asp-route-id="@item.Id" class="btn btn-outline-secondary"><i class="fas fa-pen"></i></a>
                                    <form asp-action="InciDelete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Διαγραφή του συστατικού;');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="erp-empty">
                <div class="erp-empty-icon"><i class="fas fa-atom"></i></div>
                <h5 class="text-body">Δεν έχουν καταχωρηθεί συστατικά INCI</h5>
                <a asp-action="InciCreate" asp-route-formulaId="@formulaId" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Νέο Συστατικό</a>
            </div>
        }
    </div>
</div>

<div class="mt-4 erp-fade-in">
    <a asp-action="Manage" asp-route-id="@formulaId" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-2"></i>Πίσω στη διαχείριση</a>
</div>
