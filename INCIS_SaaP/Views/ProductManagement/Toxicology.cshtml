@model List<INCIS_SaaP.Models.ToxicologicalData>
@{
    var formulaId = (int)ViewData["FormulaId"]!;
    var formulaCode = ViewData["FormulaCode"] as string;
    ViewData["Title"] = "Τοξικολογικά · " + formulaCode;
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Index">Διαχείριση Προϊόντος</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Manage" asp-route-id="@formulaId">@formulaCode</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Τοξικολογικά</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-skull-crossbones"></i></div>
    <div class="erp-page-header-text">
        <h1>Τοξικολογικά Δεδομένα <span class="erp-badge erp-badge-warning ms-2">FORM11</span></h1>
        <div class="erp-page-header-subtitle">Φόρμουλα @formulaCode · @Model.Count εγγραφές</div>
    </div>
    <div class="erp-page-header-actions">
        <a asp-action="ToxCreate" asp-route-formulaId="@formulaId" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Νέα Εγγραφή</a>
    </div>
</div>

<div class="erp-card erp-fade-in">
    <div class="table-responsive">
        @if (Model.Any())
        {
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>INCI</th>
                        <th>%</th>
                        <th>NOAEL</th>
                        <th>SED</th>
                        <th>MoS</th>
                        <th class="d-none d-md-table-cell">Κατηγορία</th>
                        <th>Ασφαλές</th>
                        <th class="text-end">Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@(item.InciName ?? "—")</td>
                            <td>@(item.Percentage?.ToString("0.####") ?? "—")</td>
                            <td>@(item.NOAEL?.ToString("0.###") ?? "—")</td>
                            <td>@(item.SED?.ToString("0.###") ?? "—")</td>
                            <td>@(item.MoS?.ToString("0.#") ?? "—")</td>
                            <td class="d-none d-md-table-cell">@(item.ToxicologicalCategory ?? "—")</td>
                            <td>
                                @if (item.IsSafe) { <span class="erp-badge erp-badge-success"><i class="fas fa-check"></i>Ναι</span> }
                                else { <span class="erp-badge erp-badge-danger">Όχι</span> }
                            </td>
                            <td class="text-end">
                                <div class="erp-actions">
                                    <a asp-action="ToxEdit" asp-route-id="@item.Id" class="btn btn-outline-secondary"><i class="fas fa-pen"></i></a>
                                    <form asp-action="ToxDelete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Διαγραφή της εγγραφής;');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="erp-empty">
                <div class="erp-empty-icon"><i class="fas fa-skull-crossbones"></i></div>
                <h5 class="text-body">Δεν έχουν καταχωρηθεί τοξικολογικά δεδομένα</h5>
                <a asp-action="ToxCreate" asp-route-formulaId="@formulaId" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Νέα Εγγραφή</a>
            </div>
        }
    </div>
</div>

<div class="mt-4 erp-fade-in">
    <a asp-action="Manage" asp-route-id="@formulaId" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-2"></i>Πίσω στη διαχείριση</a>
</div>
