@model PaginatedList<INCIS_SaaP.Dtos.ProductFormulaListItem>
@{
    ViewData["Title"] = "Διαχείριση Προϊόντος";
    var search = ViewData["CurrentFilter"] as string;
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Διαχείριση Προϊόντος</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-boxes-stacked"></i></div>
    <div class="erp-page-header-text">
        <h1>Διαχείριση Προϊόντος</h1>
        <div class="erp-page-header-subtitle">Επιλέξτε φόρμουλα για διαχείριση των δεδομένων των εγγράφων της · @Model.TotalItems</div>
    </div>
</div>

<div class="erp-card erp-fade-in">
    <div class="erp-table-toolbar">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center w-100">
            <div class="input-group flex-grow-1" style="max-width: 420px;">
                <span class="input-group-text"><i class="fas fa-magnifying-glass"></i></span>
                <input type="search" name="searchString" value="@search" class="form-control" placeholder="Αναζήτηση κωδικού, προϊόντος, πελάτη..." />
            </div>
            <button type="submit" class="btn btn-primary">Αναζήτηση</button>
            @if (!string.IsNullOrEmpty(search))
            {
                <a asp-action="Index" class="btn btn-erp-secondary"><i class="fas fa-xmark me-1"></i>Καθαρισμός</a>
            }
        </form>
    </div>

    <div class="table-responsive">
        @if (Model.Any())
        {
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Κωδικός</th>
                        <th>Προϊόν</th>
                        <th class="d-none d-md-table-cell">Τύπος</th>
                        <th class="d-none d-lg-table-cell">Πελάτης</th>
                        <th class="d-none d-lg-table-cell">Έκδοση</th>
                        <th class="text-center">Δεδομένα</th>
                        <th style="min-width:140px;">Πληρότητα</th>
                        <th class="text-end">Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.FormulaCode</td>
                            <td>@(item.ProductName ?? "—")</td>
                            <td class="d-none d-md-table-cell">@(item.ProductType ?? "—")</td>
                            <td class="d-none d-lg-table-cell">@(item.ClientName ?? "—")</td>
                            <td class="d-none d-lg-table-cell">@(item.Version ?? "—")</td>
                            <td class="text-center"><span class="erp-badge erp-badge-info">@item.DataPointsCount</span></td>
                            <td>
                                @{
                                    var pct = item.CompletenessPercent;
                                    var barColor = pct >= 80 ? "bg-success" : pct >= 40 ? "bg-warning" : "bg-danger";
                                }
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:8px; min-width:70px;">
                                        <div class="progress-bar @barColor" role="progressbar" style="width:@pct%" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <small class="text-muted" style="width:34px;">@pct%</small>
                                </div>
                            </td>
                            <td class="text-end">
                                <a asp-action="Manage" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                    <i class="fas fa-sliders me-1"></i>Διαχείριση
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="erp-empty">
                <div class="erp-empty-icon"><i class="fas fa-boxes-stacked"></i></div>
                <h5 class="text-body">Δεν βρέθηκαν φόρμουλες</h5>
                <a asp-controller="Formulas" asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Νέα Φόρμουλα</a>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="erp-card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <small class="text-muted">Σελίδα @Model.PageIndex από @Model.TotalPages</small>
            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-searchString="@search"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (var i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchString="@search">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-searchString="@search"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
