@model List<INCIS_SaaP.Models.Allergen>
@{
    var formulaId = (int)ViewData["FormulaId"]!;
    var formulaCode = ViewData["FormulaCode"] as string;
    ViewData["Title"] = "Αλλεργιογόνα · " + formulaCode;
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Index">Διαχείριση Προϊόντος</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Manage" asp-route-id="@formulaId">@formulaCode</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Αλλεργιογόνα</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-diamond-exclamation"></i></div>
    <div class="erp-page-header-text">
        <h1>Αλλεργιογόνα <span class="erp-badge erp-badge-danger ms-2">FORM8</span></h1>
        <div class="erp-page-header-subtitle">Φόρμουλα @formulaCode · @Model.Count εγγραφές</div>
    </div>
    <div class="erp-page-header-actions">
        <a asp-action="AllergenCreate" asp-route-formulaId="@formulaId" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Νέο Αλλεργιογόνο</a>
    </div>
</div>

<div class="erp-card erp-fade-in">
    <div class="table-responsive">
        @if (Model.Any())
        {
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Όνομα</th>
                        <th class="d-none d-md-table-cell">Τύπος</th>
                        <th>Συγκέντρωση</th>
                        <th class="d-none d-lg-table-cell">Πηγή</th>
                        <th>Δηλωμένο</th>
                        <th class="text-end">Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@(item.AllergenName ?? "—")</td>
                            <td class="d-none d-md-table-cell">@(item.AllergenType ?? "—")</td>
                            <td>@(item.Concentration?.ToString("0.####") ?? "—") @item.Unit</td>
                            <td class="d-none d-lg-table-cell"><small class="text-muted">@(item.Source ?? "—")</small></td>
                            <td>
                                @if (item.IsDeclared == true) { <span class="erp-badge erp-badge-success"><i class="fas fa-check"></i>Ναι</span> }
                                else { <span class="erp-badge erp-badge-secondary">Όχι</span> }
                            </td>
                            <td class="text-end">
                                <div class="erp-actions">
                                    <a asp-action="AllergenEdit" asp-route-id="@item.Id" class="btn btn-outline-secondary"><i class="fas fa-pen"></i></a>
                                    <form asp-action="AllergenDelete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Διαγραφή του αλλεργιογόνου;');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="erp-empty">
                <div class="erp-empty-icon"><i class="fas fa-diamond-exclamation"></i></div>
                <h5 class="text-body">Δεν έχουν καταχωρηθεί αλλεργιογόνα</h5>
                <a asp-action="AllergenCreate" asp-route-formulaId="@formulaId" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Νέο Αλλεργιογόνο</a>
            </div>
        }
    </div>
</div>

<div class="mt-4 erp-fade-in">
    <a asp-action="Manage" asp-route-id="@formulaId" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-2"></i>Πίσω στη διαχείριση</a>
</div>
