@model INCIS_SaaP.Models.Formula
@{
    var formulaCode = ViewData["FormulaCode"] as string;
    ViewData["Title"] = "Στοιχεία Master Formula · " + formulaCode;
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Index">Διαχείριση Προϊόντος</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Manage" asp-route-id="@Model.Id">@formulaCode</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Στοιχεία Master Formula</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-file-medical"></i></div>
    <div class="erp-page-header-text">
        <h1>Στοιχεία Master Formula <span class="erp-badge erp-badge-secondary ms-2">FORM12</span></h1>
        <div class="erp-page-header-subtitle">Φόρμουλα @formulaCode</div>
    </div>
</div>

<div class="row justify-content-center erp-fade-in">
    <div class="col-12 col-xl-9">
        <div class="erp-card">
            <div class="erp-card-body">
                <form asp-action="MasterInfoSave" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ManufacturingSite" class="form-label fw-semibold">Τόπος Παραγωγής</label>
                            <input asp-for="ManufacturingSite" class="form-control" />
                            <span asp-validation-for="ManufacturingSite" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ManufacturingMethod" class="form-label fw-semibold">Μέθοδος Παραγωγής</label>
                            <input asp-for="ManufacturingMethod" class="form-control" />
                            <span asp-validation-for="ManufacturingMethod" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="PhysicochemicalProperties" class="form-label fw-semibold">Φυσικοχημικές Ιδιότητες</label>
                            <textarea asp-for="PhysicochemicalProperties" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="PhysicochemicalProperties" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="MicrobiologicalProperties" class="form-label fw-semibold">Μικροβιολογικές Ιδιότητες</label>
                            <textarea asp-for="MicrobiologicalProperties" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="MicrobiologicalProperties" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="PackagingInfo" class="form-label fw-semibold">Πληροφορίες Συσκευασίας</label>
                            <input asp-for="PackagingInfo" class="form-control" />
                            <span asp-validation-for="PackagingInfo" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Comments" class="form-label fw-semibold">Σχόλια</label>
                            <textarea asp-for="Comments" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Comments" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-2"></i>Αποθήκευση</button>
                        <a asp-action="Manage" asp-route-id="@Model.Id" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-2"></i>Πίσω</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
