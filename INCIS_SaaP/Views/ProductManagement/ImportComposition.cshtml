@{
    var formulaId = (int)ViewData["FormulaId"]!;
    var formulaCode = ViewData["FormulaCode"] as string;
    ViewData["Title"] = "Εισαγωγή Σύνθεσης από Excel · " + formulaCode;
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Index">Διαχείριση Προϊόντος</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Manage" asp-route-id="@formulaId">@formulaCode</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Composition" asp-route-formulaId="@formulaId">Σύνθεση Α' Υλών</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Εισαγωγή από Excel</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-file-excel"></i></div>
    <div class="erp-page-header-text">
        <h1>Εισαγωγή Σύνθεσης από Excel</h1>
        <div class="erp-page-header-subtitle">Φόρμουλα @formulaCode</div>
    </div>
</div>

<div class="row justify-content-center erp-fade-in">
    <div class="col-12 col-xl-8">
        <div class="erp-card">
            <div class="erp-card-body">
                <div class="alert alert-info small">
                    <i class="fas fa-circle-info me-2"></i>
                    Το αρχείο <strong>.xlsx</strong> πρέπει να έχει κεφαλίδες στην 1η γραμμή με στήλες για:
                    <ul class="mb-0 mt-1">
                        <li><strong>Κωδικό</strong> α' ύλης (κεφαλίδα: <code>Code</code>, <code>ID</code> ή <code>Prisma</code>) — γίνεται αντιστοίχιση με τις α' ύλες του συστήματος</li>
                        <li><strong>Ποσοστό</strong> (κεφαλίδα: <code>% w/w</code> ή <code>Ποσοστό</code>)</li>
                        <li><strong>Φάση</strong> (προαιρετικό, κεφαλίδα: <code>Phase</code> ή <code>Φάση</code>)</li>
                    </ul>
                </div>

                <form asp-action="ImportComposition" asp-route-formulaId="@formulaId" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Αρχείο Excel (.xlsx) <span class="text-danger">*</span></label>
                        <input type="file" name="file" class="form-control" accept=".xlsx" required />
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" name="replaceExisting" value="true" id="replaceExisting" />
                        <label class="form-check-label" for="replaceExisting">Αντικατάσταση υπάρχουσας σύνθεσης (διαγραφή πριν την εισαγωγή)</label>
                    </div>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-upload me-2"></i>Εισαγωγή</button>
                        <a asp-action="Composition" asp-route-formulaId="@formulaId" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-2"></i>Ακύρωση</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
