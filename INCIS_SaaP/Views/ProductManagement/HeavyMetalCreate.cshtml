@model INCIS_SaaP.Models.HeavyMetal
@{
    var formulaCode = ViewData["FormulaCode"] as string;
    ViewData["Title"] = "Νέο Βαρύ Μέταλλο · " + formulaCode;
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Index">Διαχείριση Προϊόντος</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Manage" asp-route-id="@Model.FormulaId">@formulaCode</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="HeavyMetals" asp-route-formulaId="@Model.FormulaId">Βαρέα Μέταλλα</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Νέο</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-shield-halved"></i></div>
    <div class="erp-page-header-text">
        <h1>Νέο Βαρύ Μέταλλο</h1>
        <div class="erp-page-header-subtitle">Φόρμουλα @formulaCode</div>
    </div>
</div>

<div class="row justify-content-center erp-fade-in">
    <div class="col-12 col-xl-8">
        <div class="erp-card">
            <div class="erp-card-body">
                <form asp-action="HeavyMetalCreate" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FormulaId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

                    <partial name="_HeavyMetalFields" model="Model" />

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-2"></i>Δημιουργία</button>
                        <a asp-action="HeavyMetals" asp-route-formulaId="@Model.FormulaId" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-2"></i>Ακύρωση</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
