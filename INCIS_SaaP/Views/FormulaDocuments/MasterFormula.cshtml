@*
    FORM12 - Master Formula Document
    Author: Damianos Pythagoras Ougkrenidis
*@
@model INCIS_SaaP.Dtos.MasterFormulaDocumentViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FORM12 - Master Formula - @Model.FormulaCode</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --doc-primary: #004d40;
            --doc-primary-light: #00695c;
            --doc-accent: #26a69a;
            --doc-accent-light: #80cbc4;
            --doc-bg: #f5f7f6;
            --doc-card-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }

        * {
            font-family: 'Inter', 'Segoe UI', Roboto, sans-serif;
            box-sizing: border-box;
        }

        body {
            background: var(--doc-bg);
            color: #212121;
            font-size: 12px;
            line-height: 1.5;
        }

        .document-container {
            max-width: 297mm;
            margin: 0 auto;
            padding: 16px;
        }

        /* ── Header ── */
        .doc-header {
            background: linear-gradient(135deg, var(--doc-primary) 0%, var(--doc-primary-light) 40%, var(--doc-accent) 100%);
            color: #fff;
            border-radius: 16px;
            padding: 24px 28px;
            margin-bottom: 20px;
            box-shadow: 0 8px 32px rgba(0,77,64,0.3);
            position: relative;
            overflow: hidden;
        }

        .doc-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 350px;
            height: 350px;
            background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 70%);
            border-radius: 50%;
        }

        .doc-header::after {
            content: '';
            position: absolute;
            bottom: -40%;
            left: 30%;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(38,166,154,0.2) 0%, transparent 70%);
            border-radius: 50%;
        }

        .doc-header .form-badge {
            display: inline-block;
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .doc-header h1 {
            font-size: 22px;
            font-weight: 800;
            margin: 0 0 4px 0;
            letter-spacing: -0.3px;
        }

        .doc-header .subtitle {
            font-size: 12px;
            opacity: 0.85;
            font-weight: 400;
        }

        .header-meta {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 6px;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid rgba(255,255,255,0.2);
        }

        .header-meta-item .label {
            opacity: 0.7;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            font-size: 9px;
        }

        .header-meta-item .value {
            font-weight: 600;
            font-size: 12px;
        }

        /* ── Cards ── */
        .doc-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: var(--doc-card-shadow);
            margin-bottom: 16px;
            overflow: hidden;
        }

        .doc-card-header {
            padding: 12px 18px;
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid #e0f2f1;
            background: linear-gradient(135deg, #f1faf9 0%, #e0f2f1 100%);
        }

        .doc-card-header i {
            color: var(--doc-primary-light);
            font-size: 15px;
        }

        .doc-card-body {
            padding: 16px 18px;
        }

        /* ── Properties Grid ── */
        .properties-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .property-block {
            padding: 14px 16px;
            background: linear-gradient(135deg, #fafffe, #e8f5e9);
            border: 1px solid #c8e6c9;
            border-radius: 10px;
        }

        .property-block h4 {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--doc-primary);
            margin: 0 0 8px 0;
        }

        .property-block p {
            margin: 0;
            font-size: 12px;
            color: #424242;
            white-space: pre-line;
        }

        /* ── Phase Section ── */
        .phase-section {
            margin-bottom: 16px;
        }

        .phase-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            background: linear-gradient(135deg, var(--doc-primary), var(--doc-primary-light));
            color: #fff;
            border-radius: 10px 10px 0 0;
            font-weight: 700;
            font-size: 13px;
        }

        .phase-header .phase-total {
            margin-left: auto;
            background: rgba(255,255,255,0.2);
            padding: 2px 12px;
            border-radius: 12px;
            font-size: 11px;
        }

        /* ── Table ── */
        .doc-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 11px;
        }

        .doc-table thead th {
            background: #37474f;
            color: #fff;
            padding: 8px 6px;
            font-weight: 600;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            text-align: center;
            white-space: nowrap;
        }

        .doc-table tbody td {
            padding: 6px;
            border-bottom: 1px solid #eceff1;
            vertical-align: middle;
        }

        .doc-table tbody tr:hover {
            background: #f1faf9;
        }

        .phase-total-row td {
            background: #e8f5e9 !important;
            font-weight: 700;
            border-top: 2px solid var(--doc-accent);
        }

        .grand-total-row td {
            background: linear-gradient(135deg, var(--doc-primary), var(--doc-primary-light)) !important;
            color: #fff !important;
            font-weight: 800;
            font-size: 12px;
            padding: 10px 6px;
        }

        /* ── Packaging ── */
        .packaging-content {
            padding: 14px 16px;
            background: linear-gradient(135deg, #fff8e1, #fff3e0);
            border: 1px solid #ffe0b2;
            border-radius: 10px;
            font-size: 12px;
            white-space: pre-line;
        }

        /* ── Footer ── */
        .doc-footer {
            text-align: center;
            padding: 14px;
            font-size: 10px;
            color: #9e9e9e;
            border-top: 1px solid #e0e0e0;
            margin-top: 20px;
        }

        /* ── Print ── */
        .print-bar {
            text-align: center;
            margin-bottom: 16px;
        }

        .btn-print {
            background: linear-gradient(135deg, var(--doc-primary), var(--doc-accent));
            color: #fff;
            border: none;
            padding: 10px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(0,77,64,0.3);
            transition: all 0.2s;
        }

        .btn-print:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(0,77,64,0.4);
        }

        @@media print {
            body { background: #fff; font-size: 10px; }
            .print-bar { display: none !important; }
            .document-container { max-width: 100%; padding: 0; margin: 0; }
            .doc-header { box-shadow: none; border-radius: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .doc-card { box-shadow: none; border: 1px solid #e0e0e0; break-inside: avoid; }
            .doc-table thead th { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .phase-header { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .phase-total-row td, .grand-total-row td { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .property-block { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }

        @@page {
            size: A4 landscape;
            margin: 10mm;
        }
    </style>
</head>
<body>
    <div class="document-container">

        <!-- Print Button -->
        <div class="print-bar">
            <button class="btn-print" onclick="window.print()">
                <i class="fas fa-print me-2"></i>Print Document
            </button>
        </div>

        <!-- Header -->
        <div class="doc-header">
            <div class="form-badge">FORM12</div>
            <h1><i class="fas fa-flask-vial me-2"></i>Master Formula</h1>
            <div class="subtitle">Complete manufacturing formula with phases, ingredients, and specifications</div>
            <div class="header-meta">
                <div class="header-meta-item">
                    <div class="label">Formula Code</div>
                    <div class="value">@Model.FormulaCode</div>
                </div>
                <div class="header-meta-item">
                    <div class="label">Product Name</div>
                    <div class="value">@Model.ProductName</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.ProductType))
                {
                    <div class="header-meta-item">
                        <div class="label">Product Type</div>
                        <div class="value">@Model.ProductType</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ClientName))
                {
                    <div class="header-meta-item">
                        <div class="label">Client</div>
                        <div class="value">@Model.ClientName</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ManufacturingSite))
                {
                    <div class="header-meta-item">
                        <div class="label">Manufacturing Site</div>
                        <div class="value">@Model.ManufacturingSite</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ManufacturingMethod))
                {
                    <div class="header-meta-item">
                        <div class="label">Manufacturing Method</div>
                        <div class="value">@Model.ManufacturingMethod</div>
                    </div>
                }
                <div class="header-meta-item">
                    <div class="label">Generated</div>
                    <div class="value">@Model.GeneratedAt.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Version))
                {
                    <div class="header-meta-item">
                        <div class="label">Version</div>
                        <div class="value">@Model.Version</div>
                    </div>
                }
            </div>
        </div>

        <!-- Physicochemical & Microbiological Properties -->
        @if (!string.IsNullOrEmpty(Model.PhysicochemicalProperties) || !string.IsNullOrEmpty(Model.MicrobiologicalProperties))
        {
            <div class="doc-card">
                <div class="doc-card-header">
                    <i class="fas fa-microscope"></i>
                    Physicochemical &amp; Microbiological Properties
                </div>
                <div class="doc-card-body">
                    <div class="properties-grid">
                        @if (!string.IsNullOrEmpty(Model.PhysicochemicalProperties))
                        {
                            <div class="property-block">
                                <h4><i class="fas fa-atom me-1"></i> Physicochemical</h4>
                                <p>@Model.PhysicochemicalProperties</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.MicrobiologicalProperties))
                        {
                            <div class="property-block">
                                <h4><i class="fas fa-bacterium me-1"></i> Microbiological</h4>
                                <p>@Model.MicrobiologicalProperties</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Phases & Ingredients -->
        <div class="doc-card">
            <div class="doc-card-header">
                <i class="fas fa-layer-group"></i>
                Formula Phases &amp; Ingredients
                <span class="ms-auto" style="font-size: 11px; font-weight: 600; color: var(--doc-primary);">
                    Total: @Model.TotalPercentage.ToString("F2")%
                </span>
            </div>
            <div class="doc-card-body" style="padding: 12px;">
                @{
                    int globalOrder = 0;
                }
                @foreach (var phase in Model.Phases)
                {
                    <div class="phase-section">
                        <div class="phase-header">
                            <i class="fas fa-layer-group"></i>
                            @phase.PhaseName
                            <span class="phase-total">@phase.PhaseTotal.ToString("F2")%</span>
                        </div>
                        <table class="doc-table" style="border-radius: 0 0 10px 10px; overflow: hidden;">
                            <thead>
                                <tr>
                                    <th style="width:35px">A/N</th>
                                    <th>ID</th>
                                    <th>Prisma</th>
                                    <th style="text-align:left; min-width:140px;">RM Name</th>
                                    <th style="text-align:left; min-width:160px;">INCI</th>
                                    <th style="text-align:left">Supplier</th>
                                    <th style="text-align:left">Manufacturer</th>
                                    <th style="width:80px">% w/w</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ing in phase.Ingredients)
                                {
                                    globalOrder++;
                                    <tr>
                                        <td style="text-align:center; font-weight:600; color:#78909c;">@globalOrder</td>
                                        <td style="text-align:center; font-weight:500;">@ing.RawMaterialCode</td>
                                        <td style="text-align:center; font-size:10.5px; color:#546e7a;">@(ing.PrismaCode ?? "—")</td>
                                        <td style="font-weight:500;">@ing.RawMaterialName</td>
                                        <td style="font-style:italic; color:#546e7a; font-size:10.5px;">@(ing.InciName ?? "—")</td>
                                        <td style="font-size:10.5px;">@(ing.SupplierName ?? "—")</td>
                                        <td style="font-size:10.5px;">@(ing.ManufacturerName ?? "—")</td>
                                        <td style="text-align:center; font-weight:700;">@ing.Percentage.ToString("F4")</td>
                                    </tr>
                                }
                                <tr class="phase-total-row">
                                    <td colspan="7" style="text-align:right; padding-right:12px;">
                                        Phase Total &mdash; @phase.PhaseName
                                    </td>
                                    <td style="text-align:center;">@phase.PhaseTotal.ToString("F4")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }

                <!-- Grand Total -->
                <table class="doc-table" style="border-radius: 10px; overflow: hidden; margin-top: 4px;">
                    <tbody>
                        <tr class="grand-total-row">
                            <td colspan="7" style="text-align:right; padding-right:12px;">
                                <i class="fas fa-sigma me-2"></i>GRAND TOTAL
                            </td>
                            <td style="text-align:center; width:80px;">@Model.TotalPercentage.ToString("F4")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Packaging Information -->
        @if (!string.IsNullOrEmpty(Model.PackagingInfo))
        {
            <div class="doc-card">
                <div class="doc-card-header">
                    <i class="fas fa-box-open"></i>
                    Packaging Information
                </div>
                <div class="doc-card-body">
                    <div class="packaging-content">
                        @Model.PackagingInfo
                    </div>
                </div>
            </div>
        }

        <!-- Comments -->
        @if (!string.IsNullOrEmpty(Model.Comments))
        {
            <div class="doc-card">
                <div class="doc-card-header">
                    <i class="fas fa-comment-dots"></i>
                    Comments &amp; Notes
                </div>
                <div class="doc-card-body">
                    <p style="margin:0; white-space: pre-line; font-size: 12px; color: #424242;">@Model.Comments</p>
                </div>
            </div>
        }

        <!-- Footer -->
        <div class="doc-footer">
            <strong>INCIS SaaP</strong> &mdash; Master Formula Document (FORM12) &mdash;
            Generated on @Model.GeneratedAt.ToString("dd MMMM yyyy, HH:mm") &mdash;
            This document is confidential and intended for manufacturing use only.
        </div>

    </div>
</body>
</html>
