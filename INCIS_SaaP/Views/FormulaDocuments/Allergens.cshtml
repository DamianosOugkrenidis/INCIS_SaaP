@*
    FORM8 - Allergens Composition Document
    Author: Damianos Pythagoras Ougkrenidis
*@
@model INCIS_SaaP.Dtos.AllergensDocumentViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FORM8 - Allergens Composition - @Model.FormulaCode</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --doc-primary: #b71c1c;
            --doc-primary-light: #d84315;
            --doc-accent: #ff6d00;
            --doc-success: #2e7d32;
            --doc-success-light: #4caf50;
            --doc-warning: #e65100;
            --doc-danger: #b71c1c;
            --doc-danger-light: #ef5350;
            --doc-bg: #f8f9fa;
            --doc-card-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }

        * {
            font-family: 'Inter', 'Segoe UI', Roboto, sans-serif;
            box-sizing: border-box;
        }

        body {
            background: var(--doc-bg);
            color: #212121;
            font-size: 13px;
            line-height: 1.5;
            margin: 0;
            padding: 0;
        }

        .document-container {
            max-width: 210mm;
            margin: 0 auto;
            padding: 20px;
        }

        /* ── Header ── */
        .doc-header {
            background: linear-gradient(135deg, var(--doc-primary) 0%, var(--doc-primary-light) 50%, var(--doc-accent) 100%);
            color: #fff;
            border-radius: 16px;
            padding: 28px 32px;
            margin-bottom: 24px;
            box-shadow: 0 8px 32px rgba(183,28,28,0.3);
            position: relative;
            overflow: hidden;
        }

        .doc-header::before {
            content: '';
            position: absolute;
            top: -40%;
            right: -15%;
            width: 280px;
            height: 280px;
            background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 70%);
            border-radius: 50%;
        }

        .doc-header::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -10%;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(255,109,0,0.15) 0%, transparent 70%);
            border-radius: 50%;
        }

        .doc-header .form-badge {
            display: inline-block;
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 8px;
            position: relative;
            z-index: 1;
        }

        .doc-header h1 {
            font-size: 22px;
            font-weight: 800;
            margin: 0 0 4px 0;
            letter-spacing: -0.3px;
            position: relative;
            z-index: 1;
        }

        .doc-header .subtitle {
            font-size: 13px;
            opacity: 0.85;
            font-weight: 400;
            position: relative;
            z-index: 1;
        }

        .header-meta {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 8px;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid rgba(255,255,255,0.2);
            position: relative;
            z-index: 1;
        }

        .header-meta-item .label {
            opacity: 0.7;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            font-size: 9px;
        }

        .header-meta-item .value {
            font-weight: 600;
            font-size: 13px;
        }

        .header-formula-code {
            position: absolute;
            top: 28px;
            right: 32px;
            text-align: right;
            z-index: 1;
        }

        .header-formula-code .code-label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.6;
        }

        .header-formula-code .code-value {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        /* ── Section Titles ── */
        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 24px 0 14px;
            font-weight: 700;
            font-size: 14px;
            color: #37474f;
        }

        .section-title .section-num {
            background: linear-gradient(135deg, var(--doc-primary), var(--doc-primary-light));
            color: #fff;
            width: 26px;
            height: 26px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 800;
            flex-shrink: 0;
        }

        .section-title::after {
            content: '';
            flex: 1;
            height: 2px;
            background: linear-gradient(90deg, var(--doc-primary), transparent);
            border-radius: 1px;
        }

        /* ── Cards ── */
        .doc-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: var(--doc-card-shadow);
            border: 1px solid #e0e0e0;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .doc-card-header {
            background: linear-gradient(135deg, #fafafa, #f5f5f5);
            padding: 12px 18px;
            border-bottom: 2px solid #eeeeee;
            font-weight: 700;
            font-size: 13px;
            color: var(--doc-primary);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .doc-card-body {
            padding: 18px;
        }

        /* ── Info Grid ── */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 10px;
        }

        .info-item {
            padding: 10px 14px;
            background: rgba(183,28,28,0.03);
            border-radius: 8px;
            border: 1px solid rgba(183,28,28,0.08);
        }

        .info-item .info-label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #78909c;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .info-item .info-value {
            font-weight: 600;
            font-size: 13px;
            color: #263238;
        }

        /* ── Regulation Info Box ── */
        .regulation-box {
            background: linear-gradient(135deg, #fff3e0, #fff8e1);
            border: 1px solid #ffe0b2;
            border-left: 4px solid #ff9800;
            border-radius: 10px;
            padding: 16px 20px;
            margin-bottom: 20px;
        }

        .regulation-box .reg-title {
            font-weight: 700;
            font-size: 13px;
            color: #e65100;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }

        .regulation-box .reg-body {
            font-size: 12px;
            color: #5d4037;
            line-height: 1.6;
        }

        /* ── Threshold Info Box ── */
        .threshold-box {
            background: linear-gradient(135deg, #e3f2fd, #e8eaf6);
            border: 1px solid #bbdefb;
            border-radius: 12px;
            padding: 18px 22px;
            margin-bottom: 20px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .threshold-item {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .threshold-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .threshold-icon.leave-on {
            background: linear-gradient(135deg, #ffcdd2, #ef9a9a);
            color: var(--doc-danger);
        }

        .threshold-icon.rinse-off {
            background: linear-gradient(135deg, #c8e6c9, #a5d6a7);
            color: var(--doc-success);
        }

        .threshold-info .th-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
            color: #546e7a;
        }

        .threshold-info .th-value {
            font-size: 16px;
            font-weight: 800;
            color: #263238;
        }

        .threshold-info .th-desc {
            font-size: 10px;
            color: #78909c;
            margin-top: 1px;
        }

        /* ── Data Table ── */
        .data-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 11.5px;
        }

        .data-table thead th {
            background: linear-gradient(180deg, #ffebee 0%, #ffcdd2 100%);
            color: var(--doc-primary);
            font-weight: 700;
            font-size: 9.5px;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            padding: 10px 8px;
            border-bottom: 2px solid #ef9a9a;
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        .data-table tbody td {
            padding: 8px;
            border-bottom: 1px solid #f5f5f5;
            vertical-align: middle;
            color: #37474f;
        }

        .data-table tbody tr:hover {
            background: rgba(183,28,28,0.02);
        }

        /* ── Row Color Coding ── */
        .row-exceeds {
            background: linear-gradient(90deg, rgba(244,67,54,0.08) 0%, rgba(244,67,54,0.02) 100%) !important;
        }

        .row-exceeds td:first-child {
            border-left: 3px solid #f44336;
        }

        .row-below {
            background: linear-gradient(90deg, rgba(76,175,80,0.06) 0%, rgba(76,175,80,0.02) 100%) !important;
        }

        .row-below td:first-child {
            border-left: 3px solid #4caf50;
        }

        /* ── Badges ── */
        .allergen-type-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 8px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .allergen-type-badge.fragrance {
            background: #fce4ec;
            color: #c62828;
            border: 1px solid #f8bbd0;
        }

        .allergen-type-badge.preservative {
            background: #e8eaf6;
            color: #283593;
            border: 1px solid #c5cae9;
        }

        .allergen-type-badge.dye {
            background: #f3e5f5;
            color: #6a1b9a;
            border: 1px solid #e1bee7;
        }

        .allergen-type-badge.other {
            background: #eceff1;
            color: #455a64;
            border: 1px solid #cfd8dc;
        }

        .declared-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
        }

        .declared-badge.yes {
            background: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #c8e6c9;
        }

        .declared-badge.no {
            background: #fafafa;
            color: #9e9e9e;
            border: 1px solid #e0e0e0;
        }

        .threshold-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
        }

        .threshold-badge.exceeds {
            background: #ffebee;
            color: #c62828;
            border: 1px solid #ffcdd2;
        }

        .threshold-badge.below {
            background: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #c8e6c9;
        }

        .mono {
            font-family: 'SF Mono', 'Cascadia Code', 'Consolas', monospace;
            font-size: 11px;
        }

        /* ── Summary Cards ── */
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 14px;
            margin-bottom: 20px;
        }

        .summary-card {
            background: #fff;
            border-radius: 12px;
            padding: 18px;
            box-shadow: var(--doc-card-shadow);
            border: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .summary-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .summary-icon.declared-icon {
            background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
            color: #2e7d32;
        }

        .summary-icon.total-icon {
            background: linear-gradient(135deg, #ffebee, #ffcdd2);
            color: var(--doc-primary);
        }

        .summary-icon.alert-icon {
            background: linear-gradient(135deg, #fff3e0, #ffe0b2);
            color: #e65100;
        }

        .summary-info .s-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #78909c;
            font-weight: 600;
        }

        .summary-info .s-value {
            font-size: 22px;
            font-weight: 800;
            color: #263238;
            line-height: 1.2;
        }

        .summary-info .s-sub {
            font-size: 10px;
            color: #90a4ae;
        }

        /* ── Overall Status Banner ── */
        .status-banner {
            border-radius: 12px;
            padding: 18px 22px;
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 20px;
        }

        .status-banner.safe {
            background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
            border: 1px solid #a5d6a7;
        }

        .status-banner.warning {
            background: linear-gradient(135deg, #fff3e0, #ffe0b2);
            border: 1px solid #ffcc80;
        }

        .status-banner.danger {
            background: linear-gradient(135deg, #ffebee, #ffcdd2);
            border: 1px solid #ef9a9a;
        }

        .status-banner .status-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .status-banner.safe .status-icon {
            background: rgba(46,125,50,0.15);
            color: #2e7d32;
        }

        .status-banner.warning .status-icon {
            background: rgba(230,81,0,0.15);
            color: #e65100;
        }

        .status-banner.danger .status-icon {
            background: rgba(183,28,28,0.15);
            color: var(--doc-danger);
        }

        .status-banner .status-text .st-title {
            font-weight: 700;
            font-size: 14px;
            color: #263238;
        }

        .status-banner .status-text .st-desc {
            font-size: 12px;
            color: #546e7a;
            margin-top: 2px;
        }

        /* ── Progress Bar ── */
        .declaration-progress {
            background: #e0e0e0;
            border-radius: 6px;
            height: 8px;
            overflow: hidden;
            margin-top: 8px;
            max-width: 260px;
        }

        .declaration-progress .fill {
            height: 100%;
            border-radius: 6px;
            transition: width 0.4s ease;
        }

        /* ── Footer ── */
        .doc-footer {
            text-align: center;
            padding: 18px;
            color: #90a4ae;
            font-size: 10px;
            border-top: 1px solid #eceff1;
            margin-top: 24px;
        }

        .doc-footer strong {
            color: #546e7a;
        }

        /* ── Print FAB ── */
        .print-fab {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 52px;
            height: 52px;
            border-radius: 14px;
            border: none;
            background: linear-gradient(135deg, var(--doc-primary), var(--doc-primary-light));
            color: #fff;
            font-size: 18px;
            box-shadow: 0 6px 20px rgba(183,28,28,0.35);
            cursor: pointer;
            transition: all 0.2s ease;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .print-fab:hover {
            transform: scale(1.08);
            box-shadow: 0 8px 28px rgba(183,28,28,0.45);
        }

        /* ── Empty State ── */
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #90a4ae;
        }

        .empty-state i {
            font-size: 40px;
            margin-bottom: 12px;
            opacity: 0.4;
        }

        .empty-state p {
            font-size: 13px;
            font-weight: 500;
        }

        /* ===== Print Styles ===== */
        @@media print {
            @@page {
                size: A4 portrait;
                margin: 10mm;
            }

            body, html {
                background: #fff !important;
                margin: 0 !important;
                padding: 0 !important;
                font-size: 11px;
            }

            .no-print, .print-fab {
                display: none !important;
            }

            .document-container {
                max-width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            .doc-header {
                background: var(--doc-primary) !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                border-radius: 0 !important;
                padding: 16px 20px !important;
                margin-bottom: 12px !important;
                box-shadow: none !important;
            }

            .doc-card {
                box-shadow: none !important;
                border: 1px solid #ccc !important;
                border-radius: 6px !important;
                break-inside: avoid;
            }

            .regulation-box {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                break-inside: avoid;
            }

            .threshold-box {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                break-inside: avoid;
            }

            .data-table {
                font-size: 9.5px;
            }

            .data-table thead th {
                background: #ffebee !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                padding: 6px 5px;
            }

            .data-table tbody td {
                padding: 5px;
            }

            .data-table tbody tr {
                page-break-inside: avoid;
            }

            .row-exceeds, .row-below {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .row-exceeds td:first-child,
            .row-below td:first-child {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .allergen-type-badge,
            .declared-badge,
            .threshold-badge {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .summary-card {
                box-shadow: none !important;
                border: 1px solid #ccc !important;
            }

            .summary-icon, .threshold-icon, .status-banner, .status-banner .status-icon {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .status-banner {
                break-inside: avoid;
            }

            .doc-footer {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
            }
        }
    </style>
</head>
<body>
    @{
        var exceedsCount = Model.Allergens?.Count(a => a.ExceedsThreshold) ?? 0;
        var belowCount = (Model.TotalAllergens) - exceedsCount;
        var declaredPct = Model.TotalAllergens > 0
            ? (int)Math.Round((double)Model.TotalDeclared / Model.TotalAllergens * 100)
            : 0;
        var statusClass = exceedsCount == 0 ? "safe" : exceedsCount <= 3 ? "warning" : "danger";
    }

    <div class="document-container">
        <!-- ═══ Header ═══ -->
        <div class="doc-header">
            <div class="form-badge">
                <i class="fa-solid fa-shield-virus"></i>&nbsp; FORM 8
            </div>
            <div class="header-formula-code">
                <div class="code-label">Formula</div>
                <div class="code-value">@Model.FormulaCode</div>
            </div>
            <h1><i class="fa-solid fa-allergies me-2"></i>Allergens Composition</h1>
            <div class="subtitle">Identification and declaration of allergenic substances per EU Regulation (EC) No 1223/2009, Annex III</div>

            <div class="header-meta">
                <div class="header-meta-item">
                    <div class="label">Product Name</div>
                    <div class="value">@(Model.ProductName ?? "—")</div>
                </div>
                <div class="header-meta-item">
                    <div class="label">Product Type</div>
                    <div class="value">@(Model.ProductType ?? "—")</div>
                </div>
                <div class="header-meta-item">
                    <div class="label">Client</div>
                    <div class="value">@(Model.ClientName ?? "—")</div>
                </div>
                <div class="header-meta-item">
                    <div class="label">ID Code</div>
                    <div class="value">@(Model.PPIdCode ?? "—")</div>
                </div>
                <div class="header-meta-item">
                    <div class="label">Version</div>
                    <div class="value">@(Model.Version ?? "v1.0")</div>
                </div>
                <div class="header-meta-item">
                    <div class="label">Issue Date</div>
                    <div class="value">@(Model.IssueDate?.ToString("dd MMM yyyy") ?? Model.GeneratedAt.ToString("dd MMM yyyy"))</div>
                </div>
            </div>
        </div>

        <!-- ═══ EU Regulation Reference ═══ -->
        <div class="regulation-box">
            <div class="reg-title">
                <i class="fa-solid fa-scale-balanced"></i>
                EU Regulation (EC) No 1223/2009 — Annex III
            </div>
            <div class="reg-body">
                Under Article 19(1)(g) of the EU Cosmetics Regulation, the presence of certain allergenic substances must
                be indicated in the list of ingredients when their concentration exceeds the established thresholds.
                This document identifies all allergenic substances present in the finished product and evaluates their
                concentrations against the applicable declaration thresholds for <strong>leave-on</strong> and
                <strong>rinse-off</strong> cosmetic products. A total of <strong>26 fragrance allergens</strong>
                (as amended by Regulation (EU) 2023/1545) are subject to mandatory labelling.
            </div>
        </div>

        <!-- ═══ Section 1: Declaration Thresholds ═══ -->
        <div class="section-title">
            <span class="section-num">1</span>
            <i class="fa-solid fa-sliders" style="color:var(--doc-primary);"></i>
            Declaration Thresholds
        </div>

        <div class="threshold-box">
            <div class="threshold-item">
                <div class="threshold-icon leave-on">
                    <i class="fa-solid fa-hand-holding-droplet"></i>
                </div>
                <div class="threshold-info">
                    <div class="th-label">Leave-on Products</div>
                    <div class="th-value">@Model.DeclarationThresholdLeaveOn.ToString("0.000")%</div>
                    <div class="th-desc">10 ppm (0.001%) — Must declare if exceeded</div>
                </div>
            </div>
            <div class="threshold-item">
                <div class="threshold-icon rinse-off">
                    <i class="fa-solid fa-shower"></i>
                </div>
                <div class="threshold-info">
                    <div class="th-label">Rinse-off Products</div>
                    <div class="th-value">@Model.DeclarationThresholdRinseOff.ToString("0.0")%</div>
                    <div class="th-desc">100 ppm (0.01%) — Must declare if exceeded</div>
                </div>
            </div>
        </div>

        <!-- ═══ Section 2: Allergens Analysis ═══ -->
        <div class="section-title">
            <span class="section-num">2</span>
            <i class="fa-solid fa-table-list" style="color:var(--doc-primary);"></i>
            Allergens Analysis
        </div>

        <div class="doc-card">
            <div class="doc-card-header">
                <i class="fa-solid fa-flask-vial"></i>
                Complete Allergen Composition
                <span style="margin-left:auto;background:#ffebee;color:var(--doc-primary);padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;">
                    @Model.TotalAllergens allergen@(Model.TotalAllergens != 1 ? "s" : "")
                </span>
            </div>
            <div style="overflow-x:auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width:35px;text-align:center;">A/N</th>
                            <th>Allergen Name</th>
                            <th>CAS Number</th>
                            <th>EC Number</th>
                            <th>Type</th>
                            <th style="text-align:right;">Concentration</th>
                            <th style="text-align:center;">Unit</th>
                            <th>Source</th>
                            <th style="text-align:center;">Declared</th>
                            <th style="text-align:center;">Threshold</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Allergens != null && Model.Allergens.Any())
                        {
                            @foreach (var allergen in Model.Allergens.OrderBy(a => a.Order))
                            {
                                var rowClass = allergen.ExceedsThreshold ? "row-exceeds" : "row-below";
                                var typeClass = (allergen.AllergenType?.ToLower()) switch
                                {
                                    "fragrance" => "fragrance",
                                    "preservative" => "preservative",
                                    "dye" or "colorant" => "dye",
                                    _ => "other"
                                };
                                <tr class="@rowClass">
                                    <td style="text-align:center;" class="mono"><strong>@allergen.Order</strong></td>
                                    <td>
                                        <strong>@allergen.AllergenName</strong>
                                    </td>
                                    <td class="mono">@(allergen.CASNumber ?? "—")</td>
                                    <td class="mono">@(allergen.ECNumber ?? "—")</td>
                                    <td>
                                        <span class="allergen-type-badge @typeClass">
                                            @if (typeClass == "fragrance")
                                            {
                                                <i class="fa-solid fa-spray-can-sparkles"></i>
                                            }
                                            else if (typeClass == "preservative")
                                            {
                                                <i class="fa-solid fa-shield-halved"></i>
                                            }
                                            else if (typeClass == "dye")
                                            {
                                                <i class="fa-solid fa-palette"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-circle-question"></i>
                                            }
                                            @(allergen.AllergenType ?? "Other")
                                        </span>
                                    </td>
                                    <td style="text-align:right;" class="mono">
                                        <strong>@(allergen.Concentration?.ToString("F6") ?? "—")</strong>
                                    </td>
                                    <td style="text-align:center;" class="mono">@(allergen.Unit ?? "%")</td>
                                    <td style="max-width:120px;font-size:10px;">@(allergen.Source ?? "—")</td>
                                    <td style="text-align:center;">
                                        @if (allergen.IsDeclared)
                                        {
                                            <span class="declared-badge yes">
                                                <i class="fa-solid fa-circle-check"></i> Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="declared-badge no">
                                                <i class="fa-solid fa-circle-xmark"></i> No
                                            </span>
                                        }
                                    </td>
                                    <td style="text-align:center;">
                                        @if (allergen.ExceedsThreshold)
                                        {
                                            <span class="threshold-badge exceeds">
                                                <i class="fa-solid fa-arrow-up"></i> Exceeds
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="threshold-badge below">
                                                <i class="fa-solid fa-arrow-down"></i> Below
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10">
                                    <div class="empty-state">
                                        <i class="fa-solid fa-inbox d-block"></i>
                                        <p>No allergenic substances identified in this formula.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ═══ Section 3: Summary ═══ -->
        <div class="section-title">
            <span class="section-num">3</span>
            <i class="fa-solid fa-chart-pie" style="color:var(--doc-primary);"></i>
            Declaration Summary
        </div>

        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-icon declared-icon">
                    <i class="fa-solid fa-clipboard-check"></i>
                </div>
                <div class="summary-info">
                    <div class="s-label">Declared</div>
                    <div class="s-value">@Model.TotalDeclared</div>
                    <div class="s-sub">Must appear on label</div>
                </div>
            </div>
            <div class="summary-card">
                <div class="summary-icon total-icon">
                    <i class="fa-solid fa-flask"></i>
                </div>
                <div class="summary-info">
                    <div class="s-label">Total Allergens</div>
                    <div class="s-value">@Model.TotalAllergens</div>
                    <div class="s-sub">Identified in formula</div>
                </div>
            </div>
            <div class="summary-card">
                <div class="summary-icon alert-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div class="summary-info">
                    <div class="s-label">Exceeds Threshold</div>
                    <div class="s-value">@exceedsCount</div>
                    <div class="s-sub">Above declaration limit</div>
                </div>
            </div>
        </div>

        <!-- Overall Status -->
        <div class="status-banner @statusClass">
            <div class="status-icon">
                @if (statusClass == "safe")
                {
                    <i class="fa-solid fa-shield-check"></i>
                }
                else if (statusClass == "warning")
                {
                    <i class="fa-solid fa-circle-exclamation"></i>
                }
                else
                {
                    <i class="fa-solid fa-triangle-exclamation"></i>
                }
            </div>
            <div class="status-text flex-grow-1">
                <div class="st-title">
                    @if (exceedsCount == 0)
                    {
                        <span>All Allergens Below Declaration Threshold</span>
                    }
                    else
                    {
                        <span>@exceedsCount Allergen@(exceedsCount != 1 ? "s" : "") Exceed@(exceedsCount == 1 ? "s" : "") Declaration Threshold</span>
                    }
                </div>
                <div class="st-desc">
                    @Model.TotalDeclared of @Model.TotalAllergens allergens require declaration on the product label.
                </div>
                @if (Model.TotalAllergens > 0)
                {
                    <div class="declaration-progress">
                        <div class="fill" style="width:@(declaredPct)%;background:@(statusClass == "safe" ? "#4caf50" : statusClass == "warning" ? "#ff9800" : "#f44336");"></div>
                    </div>
                    <div style="font-size:10px;color:#78909c;margin-top:3px;">@declaredPct% declaration rate</div>
                }
            </div>
        </div>

        <!-- ═══ Footer ═══ -->
        <div class="doc-footer">
            <strong>INCIS SaaP</strong> &mdash; Allergens Composition Report (FORM8) &mdash;
            EU Regulation (EC) No 1223/2009, Annex III &mdash;
            Generated on @Model.GeneratedAt.ToString("dd MMMM yyyy, HH:mm") &mdash;
            @(Model.PPIdCode ?? Model.FormulaCode)
        </div>
    </div>

    <!-- Print FAB -->
    <button class="print-fab no-print" onclick="window.print()" title="Print Document">
        <i class="fa-solid fa-print"></i>
    </button>
</body>
</html>
