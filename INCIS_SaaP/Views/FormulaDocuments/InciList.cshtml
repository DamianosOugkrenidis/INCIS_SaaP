@*
    FORM13 - INCI List Document
    Author: Damianos Pythagoras Ougkrenidis
*@
@model INCIS_SaaP.Dtos.InciListDocumentViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FORM13 - INCI List - @Model.FormulaCode</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --doc-primary: #0d47a1;
            --doc-primary-light: #1565c0;
            --doc-accent: #42a5f5;
            --doc-bg: #f8f9fb;
            --doc-card-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }

        * {
            font-family: 'Inter', 'Segoe UI', Roboto, sans-serif;
            box-sizing: border-box;
        }

        body {
            background: var(--doc-bg);
            color: #212121;
            font-size: 13px;
            line-height: 1.6;
        }

        .document-container {
            max-width: 210mm;
            margin: 0 auto;
            padding: 20px;
        }

        /* ── Header ── */
        .doc-header {
            background: linear-gradient(135deg, var(--doc-primary) 0%, var(--doc-primary-light) 50%, var(--doc-accent) 100%);
            color: #fff;
            border-radius: 16px;
            padding: 28px 32px;
            margin-bottom: 28px;
            box-shadow: 0 8px 32px rgba(13,71,161,0.3);
            position: relative;
            overflow: hidden;
        }

        .doc-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 320px;
            height: 320px;
            background: radial-gradient(circle, rgba(255,255,255,0.07) 0%, transparent 70%);
            border-radius: 50%;
        }

        .doc-header::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -5%;
            width: 180px;
            height: 180px;
            background: radial-gradient(circle, rgba(66,165,245,0.2) 0%, transparent 70%);
            border-radius: 50%;
        }

        .doc-header .form-badge {
            display: inline-block;
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .doc-header h1 {
            font-size: 24px;
            font-weight: 800;
            margin: 0 0 4px 0;
            letter-spacing: -0.3px;
        }

        .doc-header .subtitle {
            font-size: 13px;
            opacity: 0.85;
            font-weight: 400;
        }

        .header-meta {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 8px;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid rgba(255,255,255,0.2);
        }

        .header-meta-item .label {
            opacity: 0.7;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            font-size: 9px;
        }

        .header-meta-item .value {
            font-weight: 600;
            font-size: 13px;
        }

        /* ── INCI Box ── */
        .inci-box {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(13,71,161,0.1);
            padding: 32px;
            margin-bottom: 24px;
            position: relative;
            border: 2px solid #e3f2fd;
        }

        .inci-box::before {
            content: 'INGREDIENTS';
            position: absolute;
            top: -12px;
            left: 28px;
            background: linear-gradient(135deg, var(--doc-primary), var(--doc-accent));
            color: #fff;
            padding: 4px 18px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            box-shadow: 0 3px 10px rgba(13,71,161,0.25);
        }

        .inci-text {
            font-size: 15px;
            line-height: 2;
            color: #263238;
            font-weight: 400;
            word-spacing: 2px;
            text-align: justify;
            padding-top: 8px;
        }

        /* ── Info Cards ── */
        .info-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 24px;
        }

        .info-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: var(--doc-card-shadow);
            padding: 20px 24px;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .info-card .icon-wrap {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .info-card .icon-wrap.count {
            background: linear-gradient(135deg, #e3f2fd, #bbdefb);
            color: var(--doc-primary);
        }

        .info-card .icon-wrap.order {
            background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
            color: #2e7d32;
        }

        .info-card .text-wrap h4 {
            margin: 0;
            font-size: 22px;
            font-weight: 800;
            color: #212121;
        }

        .info-card .text-wrap p {
            margin: 2px 0 0 0;
            font-size: 12px;
            color: #757575;
            font-weight: 500;
        }

        /* ── Note ── */
        .note-block {
            background: linear-gradient(135deg, #fff8e1, #fff3e0);
            border: 1px solid #ffe0b2;
            border-radius: 12px;
            padding: 16px 20px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 24px;
        }

        .note-block i {
            color: #f57c00;
            font-size: 18px;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .note-block p {
            margin: 0;
            font-size: 12px;
            color: #5d4037;
            line-height: 1.6;
        }

        /* ── Individual INCI Names (optional list) ── */
        .inci-names-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 6px;
            margin-top: 16px;
        }

        .inci-name-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            background: #f5f8ff;
            border-radius: 8px;
            font-size: 12px;
            border: 1px solid #e8eaf6;
        }

        .inci-name-item .num {
            background: var(--doc-primary);
            color: #fff;
            font-size: 9px;
            font-weight: 700;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        /* ── Footer ── */
        .doc-footer {
            text-align: center;
            padding: 16px;
            font-size: 10px;
            color: #9e9e9e;
            border-top: 1px solid #e0e0e0;
            margin-top: 24px;
        }

        /* ── Print ── */
        .print-bar {
            text-align: center;
            margin-bottom: 20px;
        }

        .btn-print {
            background: linear-gradient(135deg, var(--doc-primary), var(--doc-accent));
            color: #fff;
            border: none;
            padding: 10px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(13,71,161,0.3);
            transition: all 0.2s;
        }

        .btn-print:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(13,71,161,0.4);
        }

        @@media print {
            body { background: #fff; }
            .print-bar { display: none !important; }
            .document-container { max-width: 100%; padding: 0; margin: 0; }
            .doc-header { box-shadow: none; border-radius: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .inci-box { box-shadow: none; }
            .info-card { box-shadow: none; border: 1px solid #e0e0e0; }
            .inci-box::before { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .info-card .icon-wrap { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .note-block { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }

        @@page {
            size: A4 portrait;
            margin: 15mm;
        }
    </style>
</head>
<body>
    <div class="document-container">

        <!-- Print Button -->
        <div class="print-bar">
            <button class="btn-print" onclick="window.print()">
                <i class="fas fa-print me-2"></i>Print Document
            </button>
        </div>

        <!-- Header -->
        <div class="doc-header">
            <div class="form-badge">FORM13</div>
            <h1><i class="fas fa-list-check me-2"></i>INCI List</h1>
            <div class="subtitle">International Nomenclature of Cosmetic Ingredients declaration</div>
            <div class="header-meta">
                <div class="header-meta-item">
                    <div class="label">Formula Code</div>
                    <div class="value">@Model.FormulaCode</div>
                </div>
                <div class="header-meta-item">
                    <div class="label">Product Name</div>
                    <div class="value">@Model.ProductName</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.ProductType))
                {
                    <div class="header-meta-item">
                        <div class="label">Product Type</div>
                        <div class="value">@Model.ProductType</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ClientName))
                {
                    <div class="header-meta-item">
                        <div class="label">Client</div>
                        <div class="value">@Model.ClientName</div>
                    </div>
                }
                <div class="header-meta-item">
                    <div class="label">Generated</div>
                    <div class="value">@Model.GeneratedAt.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Version))
                {
                    <div class="header-meta-item">
                        <div class="label">Version</div>
                        <div class="value">@Model.Version</div>
                    </div>
                }
            </div>
        </div>

        <!-- Info Cards -->
        <div class="info-row">
            <div class="info-card">
                <div class="icon-wrap count">
                    <i class="fas fa-hashtag"></i>
                </div>
                <div class="text-wrap">
                    <h4>@Model.TotalIngredients</h4>
                    <p>Total INCI Ingredients</p>
                </div>
            </div>
            <div class="info-card">
                <div class="icon-wrap order">
                    <i class="fas fa-sort-amount-down"></i>
                </div>
                <div class="text-wrap">
                    <h4>Descending</h4>
                    <p>Ordered by Concentration</p>
                </div>
            </div>
        </div>

        <!-- INCI List Box -->
        <div class="inci-box">
            <div class="inci-text">
                @Model.InciList
            </div>
        </div>

        <!-- Note -->
        <div class="note-block">
            <i class="fas fa-circle-info"></i>
            <p>
                <strong>Note:</strong> Ingredients are listed in descending order of concentration as required by
                <strong>Regulation (EC) No 1223/2009</strong>, Article 19(1)(g). Ingredients at concentrations below 1%
                may be listed in any order after those present at concentrations above 1%. Colorants may be listed in any order
                using the CI (Colour Index) number.
            </p>
        </div>

        <!-- Individual INCI Names -->
        @if (Model.InciNames.Any())
        {
            <div style="background:#fff; border-radius:12px; box-shadow: var(--doc-card-shadow); padding: 20px; margin-bottom: 24px;">
                <h3 style="font-size: 14px; font-weight: 700; margin: 0 0 12px 0; color: var(--doc-primary);">
                    <i class="fas fa-th-list me-2"></i>Individual Ingredients
                </h3>
                <div class="inci-names-grid">
                    @for (int i = 0; i < Model.InciNames.Count; i++)
                    {
                        <div class="inci-name-item">
                            <span class="num">@(i + 1)</span>
                            <span>@Model.InciNames[i]</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Footer -->
        <div class="doc-footer">
            <strong>INCIS SaaP</strong> &mdash; INCI List Document (FORM13) &mdash;
            Generated on @Model.GeneratedAt.ToString("dd MMMM yyyy, HH:mm") &mdash;
            Compliant with Regulation (EC) No 1223/2009.
        </div>

    </div>
</body>
</html>
