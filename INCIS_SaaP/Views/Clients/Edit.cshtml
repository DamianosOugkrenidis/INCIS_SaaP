@model INCIS_SaaP.Models.Client
@{
    ViewData["Title"] = "Επεξεργασία Πελάτη";
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Index">Πελάτες</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Επεξεργασία</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-pen-to-square"></i></div>
    <div class="erp-page-header-text">
        <h1>Επεξεργασία Πελάτη</h1>
        <div class="erp-page-header-subtitle">@Model.Name</div>
    </div>
</div>

<div class="row justify-content-center erp-fade-in">
    <div class="col-12 col-xl-8">
        <div class="erp-card">
            <div class="erp-card-header"><h3><i class="fas fa-id-card text-erp-primary"></i> Στοιχεία Πελάτη</h3></div>
            <div class="erp-card-body">
                <form asp-action="Edit" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

                    <div class="row g-3">
                        <div class="col-md-8"><label asp-for="Name" class="form-label fw-semibold">Όνομα <span class="text-danger">*</span></label><input asp-for="Name" class="form-control" required /><span asp-validation-for="Name" class="text-danger"></span></div>
                        <div class="col-md-4"><label asp-for="Code" class="form-label fw-semibold">Κωδικός</label><input asp-for="Code" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="Email" class="form-label fw-semibold">Email</label><input asp-for="Email" type="email" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="Phone" class="form-label fw-semibold">Τηλέφωνο</label><input asp-for="Phone" class="form-control" /></div>
                        <div class="col-12"><label asp-for="Address" class="form-label fw-semibold">Διεύθυνση</label><textarea asp-for="Address" class="form-control" rows="2"></textarea></div>
                        <div class="col-md-4"><label asp-for="ContactPerson" class="form-label fw-semibold">Υπεύθυνος</label><input asp-for="ContactPerson" class="form-control" /></div>
                        <div class="col-md-4"><label asp-for="ContactEmail" class="form-label fw-semibold">Email Επικοινωνίας</label><input asp-for="ContactEmail" type="email" class="form-control" /></div>
                        <div class="col-md-4"><label asp-for="ContactPhone" class="form-label fw-semibold">Τηλέφωνο Επικοινωνίας</label><input asp-for="ContactPhone" class="form-control" /></div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive" />
                                <label class="form-check-label" for="IsActive">Ενεργός</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-2"></i>Αποθήκευση</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-2"></i>Ακύρωση</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
