@model INCIS_SaaP.Dtos.ImportPreviewResult
@{
    ViewData["Title"] = "Προεπισκόπηση Εισαγωγής";
    string StatusBadge(string s) => s switch
    {
        "ok" => "<span class='badge bg-success'>Έγκυρη</span>",
        "duplicate" => "<span class='badge bg-warning text-dark'>Διπλότυπο</span>",
        _ => "<span class='badge bg-danger'>Σφάλμα</span>"
    };
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Index">Εισαγωγή</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Προεπισκόπηση</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-eye"></i></div>
    <div class="erp-page-header-text">
        <h1>Προεπισκόπηση — @INCIS_SaaP.Services.ImportService.DisplayName(Model.Type)</h1>
        <div class="erp-page-header-subtitle">Αρχείο: @Model.FileName</div>
    </div>
</div>

@if (Model.FatalError != null)
{
    <div class="alert alert-danger erp-fade-in">
        <i class="fas fa-triangle-exclamation me-2"></i>@Model.FatalError
    </div>
    <a asp-action="Index" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-1"></i>Πίσω</a>
    return;
}

<div class="row g-3 erp-fade-in mb-3">
    <div class="col-6 col-md-3"><div class="erp-card"><div class="erp-card-body text-center"><div class="fs-3 fw-bold">@Model.TotalRows</div><small class="text-muted">Σύνολο γραμμών</small></div></div></div>
    <div class="col-6 col-md-3"><div class="erp-card"><div class="erp-card-body text-center"><div class="fs-3 fw-bold text-success">@Model.ValidRows</div><small class="text-muted">Έγκυρες</small></div></div></div>
    <div class="col-6 col-md-3"><div class="erp-card"><div class="erp-card-body text-center"><div class="fs-3 fw-bold text-warning">@Model.DuplicateRows</div><small class="text-muted">Διπλότυπα</small></div></div></div>
    <div class="col-6 col-md-3"><div class="erp-card"><div class="erp-card-body text-center"><div class="fs-3 fw-bold text-danger">@Model.ErrorRows</div><small class="text-muted">Σφάλματα</small></div></div></div>
</div>

<div class="erp-card erp-fade-in mb-3">
    <div class="erp-card-body">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:70px;">Γραμμή</th>
                        <th>Τιμή</th>
                        <th>Δευτερεύον</th>
                        <th style="width:120px;">Κατάσταση</th>
                        <th>Παρατηρήσεις</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td class="text-muted">@r.RowNumber</td>
                            <td>@r.Primary</td>
                            <td class="text-muted">@r.Secondary</td>
                            <td>@Html.Raw(StatusBadge(r.Status))</td>
                            <td class="small text-muted">@string.Join(" · ", r.Messages)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex gap-2 erp-fade-in">
    <a asp-action="Index" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-1"></i>Πίσω</a>
    @if (Model.CanImport)
    {
        <form asp-action="Commit" method="post" enctype="multipart/form-data" class="d-inline-flex align-items-center gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="type" value="@Model.Type" />
            <span class="text-muted small">Για οριστική εισαγωγή, επιλέξτε ξανά το ίδιο αρχείο:</span>
            <input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" style="max-width:260px;" required />
            <button type="submit" class="btn btn-erp-primary btn-sm">
                <i class="fas fa-file-import me-1"></i>Εισαγωγή @Model.ValidRows έγκυρων
            </button>
        </form>
    }
</div>
