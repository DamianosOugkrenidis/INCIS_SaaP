@model INCIS_SaaP.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Είσοδος";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h2 class="auth-card-title">Καλώς ήρθατε</h2>
    <p class="auth-card-subtitle">Συνδεθείτε στον λογαριασμό σας για να συνεχίσετε</p>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold">
                <i class="fas fa-envelope me-2 text-erp-primary"></i>Email
            </label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-at"></i></span>
                <input asp-for="Email" class="form-control" placeholder="user@example.com" autocomplete="email" required />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-semibold">
                <i class="fas fa-lock me-2 text-erp-primary"></i>Κωδικός
            </label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-key"></i></span>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" required />
                <button type="button" class="input-group-text toggle-password" tabindex="-1" aria-label="Εμφάνιση κωδικού">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                <label class="form-check-label small" for="rememberMe">Να με θυμάσαι</label>
            </div>
            <a asp-action="ForgotPassword" class="small text-erp-primary text-decoration-none">Ξεχάσατε τον κωδικό;</a>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
            <i class="fas fa-right-to-bracket me-2"></i>Είσοδος
        </button>

        <hr class="my-4" />

        <div class="text-center small">
            <span class="text-muted">Δεν έχετε λογαριασμό;</span>
            <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="fw-semibold text-erp-primary text-decoration-none ms-1">Εγγραφή</a>
        </div>

        <div class="text-center mt-3">
            <span class="security-badge">
                <i class="fas fa-shield-halved"></i>
                Ασφαλής σύνδεση · TLS 1.3
            </span>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
