@model INCIS_SaaP.Controllers.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Ξεχάσατε τον κωδικό";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h2 class="auth-card-title">Επαναφορά Κωδικού</h2>
    <p class="auth-card-subtitle">Εισάγετε το email σας για να λάβετε σύνδεσμο επαναφοράς</p>

    <form asp-action="ForgotPassword" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold"><i class="fas fa-envelope me-2 text-erp-primary"></i>Email</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-at"></i></span>
                <input asp-for="Email" class="form-control" placeholder="user@example.com" autocomplete="email" required />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-paper-plane me-2"></i>Αποστολή συνδέσμου</button>
    </form>

    <div class="text-center mt-3">
        <a asp-action="Login" class="text-decoration-none small"><i class="fas fa-arrow-left me-1"></i>Επιστροφή στην είσοδο</a>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
