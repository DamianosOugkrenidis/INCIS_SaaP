@model INCIS_SaaP.Controllers.ChangePasswordViewModel
@{
    ViewData["Title"] = "Αλλαγή Κωδικού";
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i></a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Αλλαγή Κωδικού</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-key"></i></div>
    <div class="erp-page-header-text">
        <h1>Αλλαγή Κωδικού</h1>
        <div class="erp-page-header-subtitle">Ασφαλίστε τον λογαριασμό σας με ένα δυνατό νέο κωδικό</div>
    </div>
</div>

<div class="row justify-content-center erp-fade-in">
    <div class="col-lg-7 col-xl-6">
        <div class="erp-card">
            <div class="erp-card-header">
                <h3><i class="fas fa-shield-halved text-erp-primary"></i> Νέος κωδικός πρόσβασης</h3>
            </div>
            <div class="erp-card-body">
                <form asp-action="ChangePassword" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="OldPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input asp-for="OldPassword" type="password" class="form-control" autocomplete="current-password" required />
                            <button type="button" class="input-group-text toggle-password" tabindex="-1"><i class="fas fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="OldPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-key"></i></span>
                            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" required />
                            <button type="button" class="input-group-text toggle-password" tabindex="-1"><i class="fas fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="form-text">Τουλάχιστον 6 χαρακτήρες, με κεφαλαία/πεζά/αριθμούς για μεγαλύτερη ασφάλεια.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-check-double"></i></span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required />
                            <button type="button" class="input-group-text toggle-password" tabindex="-1"><i class="fas fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-2"></i>Αποθήκευση</button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-erp-secondary"><i class="fas fa-xmark me-2"></i>Ακύρωση</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
