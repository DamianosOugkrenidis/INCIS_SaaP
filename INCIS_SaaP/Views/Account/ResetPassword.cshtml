@model INCIS_SaaP.Controllers.ResetPasswordViewModel
@{
    ViewData["Title"] = "Επαναφορά Κωδικού";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h2 class="auth-card-title">Νέος Κωδικός</h2>
    <p class="auth-card-subtitle">Ορίστε τον νέο σας κωδικό πρόσβασης</p>

    <form asp-action="ResetPassword" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-semibold"><i class="fas fa-lock me-2 text-erp-primary"></i>Νέος Κωδικός</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-key"></i></span>
                <input asp-for="Password" class="form-control" autocomplete="new-password" required />
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label fw-semibold"><i class="fas fa-lock me-2 text-erp-primary"></i>Επιβεβαίωση</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-key"></i></span>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-floppy-disk me-2"></i>Αποθήκευση κωδικού</button>
    </form>

    <div class="text-center mt-3">
        <a asp-action="Login" class="text-decoration-none small"><i class="fas fa-arrow-left me-1"></i>Επιστροφή στην είσοδο</a>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
