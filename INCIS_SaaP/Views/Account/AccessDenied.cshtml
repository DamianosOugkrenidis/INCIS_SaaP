@{
    ViewData["Title"] = "Άρνηση Πρόσβασης";
    Layout = User?.Identity?.IsAuthenticated == true ? "_ERPLayout" : "_AuthLayout";
}

@if (User?.Identity?.IsAuthenticated == true)
{
    <div class="erp-card erp-fade-in mx-auto" style="max-width: 640px; margin-top: 2rem;">
        <div class="erp-card-body text-center py-5">
            <div class="erp-empty-icon mb-3" style="background: var(--erp-danger-soft); color: var(--erp-danger);">
                <i class="fas fa-ban"></i>
            </div>
            <h2 class="mb-2 fw-bold">Άρνηση Πρόσβασης</h2>
            <p class="text-muted mb-4">Δεν έχετε τα απαραίτητα δικαιώματα για να δείτε αυτή τη σελίδα.</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="fas fa-house me-2"></i>Επιστροφή στην Αρχική</a>
                <a asp-controller="Help" asp-action="Index" class="btn btn-erp-secondary"><i class="fas fa-circle-question me-2"></i>Βοήθεια</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="auth-card text-center" style="max-width: 460px;">
        <div class="erp-empty-icon mx-auto mb-3" style="background: var(--erp-danger-soft); color: var(--erp-danger);">
            <i class="fas fa-ban"></i>
        </div>
        <h2 class="auth-card-title">Άρνηση Πρόσβασης</h2>
        <p class="auth-card-subtitle">Πρέπει να συνδεθείτε για να δείτε αυτό το περιεχόμενο.</p>
        <a asp-action="Login" class="btn btn-primary w-100"><i class="fas fa-right-to-bracket me-2"></i>Είσοδος</a>
    </div>
}
