@model INCIS_SaaP.Models.SystemSettings
@{
    ViewData["Title"] = "Ρυθμίσεις Συστήματος";
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Εργαλεία</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-screwdriver-wrench"></i></div>
    <div class="erp-page-header-text">
        <h1>Εργαλεία &amp; Ρυθμίσεις</h1>
        <div class="erp-page-header-subtitle">Διαχείριση κωδικών πρόσβασης μονάδων (μόνο Admin)</div>
    </div>
</div>

<div class="row justify-content-center erp-fade-in">
    <div class="col-12 col-xl-8">
        <div class="erp-card">
            <div class="erp-card-header"><h3><i class="fas fa-key text-erp-primary"></i> Κωδικοί Ασφαλείας Ενοτήτων</h3></div>
            <div class="erp-card-body">
                <div class="alert alert-info small">
                    <i class="fas fa-circle-info me-1"></i>
                    Οι παρακάτω κωδικοί προστατεύουν την πρόσβαση στις ευαίσθητες ενότητες της εφαρμογής (Α’ Ύλες, Φόρμουλες).
                </div>

                <form asp-action="SetPasswords" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="RawMaterialPassword" class="form-label fw-semibold">
                                <i class="fas fa-cubes text-erp-primary me-1"></i> Κωδικός Α’ Υλών
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input asp-for="RawMaterialPassword" class="form-control" type="password" />
                                <button type="button" class="input-group-text toggle-password" tabindex="-1"><i class="fas fa-eye"></i></button>
                            </div>
                            <span asp-validation-for="RawMaterialPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FormulasPassword" class="form-label fw-semibold">
                                <i class="fas fa-flask text-erp-primary me-1"></i> Κωδικός Φόρμουλων
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input asp-for="FormulasPassword" class="form-control" type="password" />
                                <button type="button" class="input-group-text toggle-password" tabindex="-1"><i class="fas fa-eye"></i></button>
                            </div>
                            <span asp-validation-for="FormulasPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-2"></i>Αποθήκευση</button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-2"></i>Ακύρωση</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="erp-card mt-3">
            <div class="erp-card-header"><h3><i class="fas fa-circle-info text-erp-primary"></i> Πληροφορίες Συστήματος</h3></div>
            <div class="erp-card-body">
                <div class="erp-info-grid">
                    <div class="erp-info-item"><span class="erp-info-label">Έκδοση</span><span class="erp-info-value">v1.0.0</span></div>
                    <div class="erp-info-item"><span class="erp-info-label">Πλατφόρμα</span><span class="erp-info-value">ASP.NET Core</span></div>
                    <div class="erp-info-item"><span class="erp-info-label">Database</span><span class="erp-info-value">SQL Server</span></div>
                    <div class="erp-info-item"><span class="erp-info-label">Server time</span><span class="erp-info-value">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
