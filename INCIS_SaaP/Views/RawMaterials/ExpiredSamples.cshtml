@model List<INCIS_SaaP.Controllers.ExpiredSampleViewModel>
@{
    ViewData["Title"] = "Ληγμένα Δείγματα";
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Index">Α' Ύλες</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Ληγμένα Δείγματα</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-hourglass-end"></i></div>
    <div class="erp-page-header-text">
        <h1>Ληγμένα Δείγματα</h1>
        <div class="erp-page-header-subtitle">Δείγματα α' υλών που έχουν ξεπεράσει την ημερομηνία λήξης τους</div>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-3 erp-fade-in">
    <div class="col-6 col-md-3">
        <div class="erp-stat --danger">
            <div class="erp-stat-icon"><i class="fas fa-vial"></i></div>
            <div class="erp-stat-value">@Model.Count</div>
            <div class="erp-stat-label">Ληγμένα Δείγματα</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="erp-stat --warning">
            <div class="erp-stat-icon"><i class="fas fa-cubes"></i></div>
            <div class="erp-stat-value">@Model.Select(s => s.RawMaterialId).Distinct().Count()</div>
            <div class="erp-stat-label">Α' Ύλες με ληγμένα</div>
        </div>
    </div>
</div>

<!-- Search -->
<div class="erp-card mb-3 erp-fade-in">
    <div class="erp-card-body">
        <form asp-action="ExpiredSamples" method="get" class="d-flex gap-2">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Αναζήτηση με όνομα, κωδικό ή προμηθευτή..." />
            <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i>Αναζήτηση</button>
            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
            {
                <a asp-action="ExpiredSamples" class="btn btn-erp-secondary"><i class="fas fa-xmark me-1"></i>Καθαρισμός</a>
            }
        </form>
    </div>
</div>

<!-- Results -->
<div class="erp-card erp-fade-in">
    <div class="erp-card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Κωδικός</th>
                        <th>Α' Ύλη</th>
                        <th>Προμηθευτής</th>
                        <th>Παρτίδα (LOT)</th>
                        <th>Παραλαβή</th>
                        <th>Λήξη</th>
                        <th>Ημέρες Ληγμένο</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var sample in Model)
                        {
                            <tr>
                                <td><code>@sample.RawMaterialCode</code></td>
                                <td>@sample.RawMaterialName</td>
                                <td>@(sample.SupplierName ?? "—")</td>
                                <td><code>@sample.LotNumber</code></td>
                                <td>@sample.ReceivedDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-danger fw-semibold">@sample.ExpiryDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (sample.DaysExpired > 180)
                                    {
                                        <span class="erp-badge erp-badge-danger"><i class="fas fa-skull"></i> @sample.DaysExpired ημέρες</span>
                                    }
                                    else if (sample.DaysExpired > 30)
                                    {
                                        <span class="erp-badge erp-badge-warning"><i class="fas fa-triangle-exclamation"></i> @sample.DaysExpired ημέρες</span>
                                    }
                                    else
                                    {
                                        <span class="erp-badge erp-badge-info"><i class="fas fa-clock"></i> @sample.DaysExpired ημέρες</span>
                                    }
                                </td>
                                <td><a asp-action="Details" asp-route-id="@sample.RawMaterialId" class="btn btn-sm btn-erp-secondary"><i class="fas fa-eye"></i></a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4"><i class="fas fa-check-circle fs-3 d-block mb-2 text-success"></i>Δεν υπάρχουν ληγμένα δείγματα</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
