@model PaginatedList<INCIS_SaaP.Models.Formula>
@{
    ViewData["Title"] = "Φόρμουλες με αυτή την Α’ Ύλη";
    int rawMaterialId = ViewData["RawMaterialId"] != null ? Convert.ToInt32(ViewData["RawMaterialId"]) : 0;
    string rawMaterialName = ViewData["RawMaterialName"]?.ToString() ?? "";
    var search = ViewData["CurrentFilter"] as string;
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Index">Πρώτες Ύλες</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Details" asp-route-id="@rawMaterialId">@rawMaterialName</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Φόρμουλες</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-link"></i></div>
    <div class="erp-page-header-text">
        <h1>Φόρμουλες που χρησιμοποιούν αυτή την Α’ Ύλη</h1>
        <div class="erp-page-header-subtitle">Α’ Ύλη: <strong>@rawMaterialName</strong> · @Model.TotalItems φόρμουλες</div>
    </div>
    <div class="erp-page-header-actions">
        <a asp-action="Details" asp-route-id="@rawMaterialId" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-2"></i>Επιστροφή στην Α’ Ύλη</a>
    </div>
</div>

<div class="erp-card erp-fade-in">
    <div class="erp-table-toolbar">
        <form asp-action="SearchFormulas" asp-route-id="@rawMaterialId" method="get" class="d-flex flex-wrap gap-2 align-items-center w-100">
            <div class="input-group flex-grow-1" style="max-width: 420px;">
                <span class="input-group-text"><i class="fas fa-magnifying-glass"></i></span>
                <input type="search" name="searchString" value="@search" class="form-control" placeholder="Φιλτράρισμα φορμουλών..." />
            </div>
            <button type="submit" class="btn btn-primary">Αναζήτηση</button>
            @if (!string.IsNullOrEmpty(search))
            {
                <a asp-action="SearchFormulas" asp-route-id="@rawMaterialId" class="btn btn-erp-secondary"><i class="fas fa-xmark me-1"></i>Καθαρισμός</a>
            }
        </form>
    </div>

    <div class="table-responsive">
        @if (Model.Any())
        {
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Κωδικός</th>
                        <th>Όνομα</th>
                        <th class="d-none d-md-table-cell">Τύπος</th>
                        <th class="d-none d-lg-table-cell">Έκδοση</th>
                        <th class="d-none d-md-table-cell">Δημιουργία</th>
                        <th class="text-end">Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="erp-badge erp-badge-primary">@item.FormulaCode</span></td>
                            <td class="fw-semibold">@(item.FormulaName ?? item.ProductName ?? "—")</td>
                            <td class="d-none d-md-table-cell">@(item.ProductType ?? "—")</td>
                            <td class="d-none d-lg-table-cell"><code>@(item.Version ?? "v1.0")</code></td>
                            <td class="d-none d-md-table-cell"><small class="text-muted">@(item.CreationDate?.ToString("dd/MM/yyyy") ?? "—")</small></td>
                            <td class="text-end">
                                <a asp-controller="Formulas" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-eye"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="erp-empty">
                <div class="erp-empty-icon"><i class="fas fa-link-slash"></i></div>
                <h5 class="text-body">Καμία φόρμουλα</h5>
                <p>Η συγκεκριμένη α’ ύλη δεν χρησιμοποιείται σε καμία φόρμουλα.</p>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="erp-card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <small class="text-muted">Σελίδα @Model.PageIndex από @Model.TotalPages</small>
            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="SearchFormulas" asp-route-id="@rawMaterialId" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-searchString="@search"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (var i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="SearchFormulas" asp-route-id="@rawMaterialId" asp-route-pageNumber="@i" asp-route-searchString="@search">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="SearchFormulas" asp-route-id="@rawMaterialId" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-searchString="@search"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
