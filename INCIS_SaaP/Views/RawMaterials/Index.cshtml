@model PaginatedList<INCIS_SaaP.Models.RawMaterial>
@{
    ViewData["Title"] = "Πρώτες Ύλες";
    var search = ViewData["CurrentFilter"] as string;
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <span class="current">Πρώτες Ύλες</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-cubes"></i></div>
    <div class="erp-page-header-text">
        <h1>Πρώτες Ύλες</h1>
        <div class="erp-page-header-subtitle">Διαχείριση α’ υλών &amp; συσχετίσεων με προμηθευτές · @Model.TotalItems συνολικά</div>
    </div>
    <div class="erp-page-header-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Νέα Α’ Ύλη</a>
    </div>
</div>

<div class="erp-card erp-fade-in">
    <div class="erp-table-toolbar">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center w-100">
            <div class="input-group flex-grow-1" style="max-width: 420px;">
                <span class="input-group-text"><i class="fas fa-magnifying-glass"></i></span>
                <input type="search" name="searchString" value="@search" class="form-control" placeholder="Αναζήτηση κωδικού, ονόματος ή κατηγορίας..." />
            </div>
            <button type="submit" class="btn btn-primary">Αναζήτηση</button>
            @if (!string.IsNullOrEmpty(search))
            {
                <a asp-action="Index" class="btn btn-erp-secondary"><i class="fas fa-xmark me-1"></i>Καθαρισμός</a>
            }
            <span class="ms-auto small text-muted">Σύνολο <strong>@Model.TotalItems</strong></span>
        </form>
    </div>

    <div class="table-responsive">
        @if (Model.Any())
        {
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Κωδικός</th>
                        <th>Όνομα Προϊόντος</th>
                        <th class="d-none d-md-table-cell">Προμηθευτής</th>
                        <th class="d-none d-lg-table-cell">Κύρια INCI</th>
                        <th class="d-none d-lg-table-cell">Κατηγορία</th>
                        <th>Κατάσταση</th>
                        <th class="text-end">Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="erp-badge erp-badge-primary"><i class="fas fa-hashtag"></i>@item.Code</span></td>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td class="d-none d-md-table-cell">@(item.Supplier != null ? item.Supplier.Name : "—")</td>
                            <td class="d-none d-lg-table-cell">@(item.MainINCI != null ? item.MainINCI.Name : "—")</td>
                            <td class="d-none d-lg-table-cell">@(item.Category ?? "—")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="erp-badge erp-badge-success"><i class="fas fa-check"></i>Ενεργή</span>
                                }
                                else
                                {
                                    <span class="erp-badge erp-badge-secondary">Ανενεργή</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="erp-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Λεπτομέρειες"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Επεξεργασία"><i class="fas fa-pen"></i></a>
                                    <a asp-action="AddSample" asp-route-id="@item.Id" class="btn btn-outline-info" title="Δείγμα"><i class="fas fa-vial"></i></a>
                                    <a asp-action="SearchFormulas" asp-route-id="@item.Id" class="btn btn-outline-success" title="Φόρμουλες"><i class="fas fa-link"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Διαγραφή"><i class="fas fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="erp-empty">
                <div class="erp-empty-icon"><i class="fas fa-cubes"></i></div>
                <h5 class="text-body">Δεν βρέθηκαν α’ ύλες</h5>
                <p class="mb-3">@(string.IsNullOrEmpty(search) ? "Δεν υπάρχουν καταχωρήσεις α' υλών." : $"Δεν βρέθηκε αποτέλεσμα για \"{search}\".")</p>
                <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Νέα Α’ Ύλη</a>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="erp-card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <small class="text-muted">Σελίδα @Model.PageIndex από @Model.TotalPages</small>
            <nav aria-label="Σελιδοποίηση">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-searchString="@search"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (var i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchString="@search">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-searchString="@search"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
