@model INCIS_SaaP.Models.RawMaterialSample
@{
    ViewData["Title"] = "Προσθήκη Δείγματος";
    var rm = ViewBag.RawMaterial as INCIS_SaaP.Models.RawMaterial;
}

<nav class="erp-breadcrumb erp-fade-in" aria-label="breadcrumb">
    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Αρχική</a>
    <i class="fas fa-chevron-right divider"></i>
    <a asp-action="Index">Πρώτες Ύλες</a>
    <i class="fas fa-chevron-right divider"></i>
    @if (rm != null)
    {
        <a asp-action="Details" asp-route-id="@rm.Id">@rm.Code</a>
        <i class="fas fa-chevron-right divider"></i>
    }
    <span class="current">Νέο Δείγμα</span>
</nav>

<div class="erp-page-header erp-fade-in">
    <div class="erp-page-header-icon"><i class="fas fa-vial"></i></div>
    <div class="erp-page-header-text">
        <h1>Προσθήκη Δείγματος</h1>
        <div class="erp-page-header-subtitle">
            @if (rm != null)
            {
                <text>Για: <strong>@rm.ProductName</strong> · <span class="erp-badge erp-badge-primary">@rm.Code</span></text>
            }
        </div>
    </div>
</div>

<div class="row justify-content-center erp-fade-in">
    <div class="col-lg-8">
        <div class="erp-card">
            <div class="erp-card-header"><h3><i class="fas fa-flask-vial text-erp-primary"></i> Στοιχεία Δείγματος</h3></div>
            <div class="erp-card-body">
                <form asp-action="AddSample" asp-route-id="@Model.RawMaterialId" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>
                    <input type="hidden" asp-for="RawMaterialId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LotNumber" class="form-label fw-semibold">Αριθμός Παρτίδας <span class="text-danger">*</span></label>
                            <input asp-for="LotNumber" class="form-control" placeholder="π.χ. LOT-2025-001" required />
                            <span asp-validation-for="LotNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="ReceivedDate" class="form-label fw-semibold">Παραλαβή</label>
                            <input asp-for="ReceivedDate" class="form-control" type="date" />
                            <span asp-validation-for="ReceivedDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="ExpiryDate" class="form-label fw-semibold">Λήξη</label>
                            <input asp-for="ExpiryDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="alert alert-info mt-3 small">
                        <i class="fas fa-circle-info me-1"></i>
                        Η ημερομηνία λήξης πρέπει να είναι μετά την ημερομηνία παραλαβής.
                    </div>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-2"></i>Καταχώρηση</button>
                        <a asp-action="Details" asp-route-id="@Model.RawMaterialId" class="btn btn-erp-secondary"><i class="fas fa-arrow-left me-2"></i>Ακύρωση</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const r = document.getElementById('ReceivedDate');
            const e = document.getElementById('ExpiryDate');
            function check() {
                if (r && e && r.value && e.value && e.value < r.value) {
                    if (window.ErpUI) ErpUI.toast('Η ημερομηνία λήξης πρέπει να είναι μετά την παραλαβή', 'warning');
                    e.value = '';
                }
            }
            r && r.addEventListener('change', check);
            e && e.addEventListener('change', check);
        })();
    </script>
}
