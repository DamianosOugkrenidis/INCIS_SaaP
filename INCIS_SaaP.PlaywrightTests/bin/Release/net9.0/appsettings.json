{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=PYTHAGORAS;Database=INCIS_SaaP;Trusted_Connection=True;TrustServerCertificate=True;Max Pool Size=100;"
  },
  "Cache": {
    "_comment": "SQL Server distributed cache. UseSqlServer=false => in-memory distributed fallback (single instance).",
    "UseSqlServer": true,
    "SchemaName": "dbo",
    "TableName": "AppCache"
  },
  "Security": {
    "EnforceHttps": true,
    "EnableRateLimiting": true,
    "AllowSelfRegistration": true,
    "_comment_AllowSelfRegistration": "false => δημόσια εγγραφή απενεργοποιημένη (invite-only, συνιστάται για ελεγχόμενο pilot).",
    "SessionTimeoutMinutes": 30,
    "MaxLoginAttempts": 5,
    "LockoutDurationMinutes": 30
  },
  "Encryption": {
    "KeyPath": ""
  },
  "DataProtection": {
    "KeysDirectory": "%LOCALAPPDATA%\\INCIS_SaaP\\keys",
    "_comment": "Για Azure multi-instance: όρισε BlobConnectionString (ή BlobSasUri) + BlobContainer/BlobName και προαιρετικά KeyVaultKeyId για encryption-at-rest των keys.",
    "BlobConnectionString": "",
    "BlobContainer": "dataprotection-keys",
    "BlobName": "keys.xml",
    "KeyVaultKeyId": ""
  },
  "App": {
    "Url": "https://localhost:5001"
  },
  "Email": {
    "_comment": "SMTP για ειδοποιήσεις/έγκριση. Σε prod χρησιμοποίησε SendGrid/Azure Communication Services. Άδειο = email απενεργοποιημένο (graceful skip).",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "FromEmail": "noreply@incis.local",
    "FromName": "INCIS SaaP"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_USER_SECRET_OR_ENV_VAR",
    "Issuer": "INCIS_SaaP",
    "Audience": "INCIS_SaaP_Users",
    "ExpirationHours": 24
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}  {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/incis-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Swagger": {
    "Title": "INCIS SaaP API",
    "Version": "v1",
    "Description": "Cosmetic Formula Management System API"
  },
  "AdminSeed": {
    "_comment": "Σε production όρισε το Password ΜΟΝΟ μέσω User Secrets ή env var 'AdminSeed__Password' (ποτέ εδώ). Κενό = παράλειψη admin seed (καμία δημιουργία).",
    "Email": "admin.demo@incis.local",
    "Password": ""
  },
  "FeatureFlags": {
    "StorageType": "Database"
  },
  "Api": {
    "_comment": "H-2 πολιτική εγγραφής API. Enforce=false => Phase 0 (log-only, ΔΕΝ προστατεύει). Enforce=true => 403 για μη εξουσιοδοτημένους.",
    "WritePolicy": {
      "Enforce": false,
      "Roles": "Admin,SuperUser,TenantAdmin"
    },
    "Csrf": {
      "_comment": "CSRF για cookie-authenticated API writes. Enforce=false => Phase 0 (log-only, ΔΕΝ προστατεύει). Enforce=true => 400 χωρίς έγκυρο X-CSRF-TOKEN.",
      "Enforce": false,
      "HeaderName": "X-CSRF-TOKEN"
    },
    "DemoToken": {
      "_comment": "Το /api/v1/Api/token είναι DEMO και ΔΕΝ εκδίδει/επικυρώνει πραγματικά tokens. Default false => 501.",
      "Enabled": false
    }
  },
  "OpenTelemetry": {
    "ServiceName": "INCIS-SaaP",
    "EnableTracing": true,
    "EnableMetrics": true
  }
}
